<!DOCTYPE html>  <!-- scavenge.ar - © 2026 octantes.ar - SPDX-License-Identifier: Apache-2.0 -->
<html><head><meta charset="utf-8"><title>scv-chart-candle - scav component</title><link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2016%2016%22%3E%3Ctext%20x%3D%228%22%20y%3D%2212%22%20font-size%3D%2211%22%20font-family%3D%22monospace%22%20fill%3D%22%23986c98%22%20text-anchor%3D%22middle%22%3E%26lt%3B%26gt%3B%3C%2Ftext%3E%3C%2Fsvg%3E"></head>
<body style="margin:0;background:#1a1c1c">
<scv-chart-candle data-scv-component></scv-chart-candle>
<script data-scv-comp data-scv-tag="scv-chart-candle" data-scv-source="" data-scv-icon="">
customElements.define('scv-chart-candle', class extends HTMLElement { constructor() { super();
const _baked = !this.shadowRoot && this.querySelector('template[shadowrootmode], template.custom-shadow');
if (_baked) { this.attachShadow({mode: 'open'}).innerHTML = _baked.innerHTML; _baked.remove(); }
else if (!this.shadowRoot) this.attachShadow({mode: 'open'}).innerHTML = `<style>.cc { background: var(--background-sunk, #1A1C1C); border: 1px solid var(--border, #3A3C3C); border-radius: var(--corner-high, 8px); padding: 14px 16px 10px; font: 11px var(--font-mono, 'SF Mono', monospace); color: var(--text-dim, #888888); width: 440px; box-sizing: border-box; }
.cc-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; }
.cc-title { color: var(--text-base, #AAABAC); font-weight: 600; letter-spacing: 1px; }
.cc-last { font-size: 18px; color: var(--input, #8AB6BB); }
svg { display: block; width: 100%; height: 180px; }
.up { fill: var(--success, #6FAC67); stroke: var(--success, #6FAC67); }
.dn { fill: var(--danger, #985954); stroke: var(--danger, #985954); }</style><div class="cc">
  <div class="cc-head"><span class="cc-title" data-scv-slot="title">BTC / USDT</span><span class="cc-last" data-scv-slot="last">—</span></div>
  <svg viewBox="0 0 440 180" preserveAspectRatio="none"></svg>
</div>`;
const root = this.shadowRoot, host = this, emit = v => this.dispatchEvent(new CustomEvent('scv-emit', { detail: v, bubbles: true, composed: true }));
const svg = root.querySelector('svg'), last = root.querySelector('[data-scv-slot=last]');
const SAMPLES_PER = 3, MAX = 26, NS = 'http://www.w3.org/2000/svg';
let candles = [], cur = null, n = 0;
function draw() {
  while (svg.firstChild) svg.removeChild(svg.firstChild);
  const all = cur ? candles.concat([cur]) : candles;
  if (!all.length) return;
  let lo = Math.min(...all.map(c => c.l)), hi = Math.max(...all.map(c => c.h));
  if (hi === lo) { hi += 1; lo -= 1; } const pad = (hi - lo) * 0.12; lo -= pad; hi += pad;
  const W = 440, H = 180, cw = W / MAX, bw = cw * 0.6, y = v => H - ((v - lo) / (hi - lo)) * H;
  all.forEach((c, i) => {
    const x = i * cw + cw / 2, cls = c.c >= c.o ? 'up' : 'dn';
    const wick = document.createElementNS(NS, 'line');
    wick.setAttribute('x1', x); wick.setAttribute('x2', x); wick.setAttribute('y1', y(c.h)); wick.setAttribute('y2', y(c.l)); wick.setAttribute('class', cls); wick.setAttribute('stroke-width', '1'); svg.appendChild(wick);
    const bt = y(Math.max(c.o, c.c)), bb = y(Math.min(c.o, c.c));
    const body = document.createElementNS(NS, 'rect');
    body.setAttribute('x', x - bw / 2); body.setAttribute('y', bt); body.setAttribute('width', bw); body.setAttribute('height', Math.max(1, bb - bt)); body.setAttribute('class', cls); svg.appendChild(body);
  });
}
host.addEventListener('scv-receive', e => {
  const p = parseFloat(String(e.detail).replace(/[^0-9.]/g, '')); if (isNaN(p)) return;
  last.textContent = '$' + p.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  if (!cur) { cur = { o: p, h: p, l: p, c: p }; n = 1; }
  else { cur.h = Math.max(cur.h, p); cur.l = Math.min(cur.l, p); cur.c = p; n++; }
  if (n >= SAMPLES_PER) { candles.push(cur); if (candles.length > MAX) candles.shift(); cur = null; n = 0; }
  draw();
});
draw();
}
connectedCallback() { this.setAttribute('data-scv-emitter', ''); } });
</script>
</body></html>