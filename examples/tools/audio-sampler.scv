        <div class="sp-knob"><div class="sp-knob-label">voices</div><div class="sp-dial" data-sp-dial="voices"><svg viewBox="0 0 38 38" aria-hidden="true"><path class="sp-dial-base" d="M 9.1 9.1 A 14 14 0 1 1 9.1 28.9" stroke="#3A3C3C" stroke-width="4" stroke-linecap="round" fill="none"></path><path class="sp-dial-value" stroke="#8AB6BB" stroke-width="4" stroke-linecap="round" fill="none"></path><line class="sp-dial-pointer" x1="19" y1="19" stroke="#AAABAC" stroke-width="2" stroke-linecap="round"></line></svg></div><div class="sp-knob-read" data-sp="read-voices">4</div></div>
