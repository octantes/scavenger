      if (px >= 0 && px <= w) { c.strokeStyle = '#FFFFFF'; c.lineWidth = 1.5; c.beginPath(); c.moveTo(px + 0.5, 0); c.lineTo(px + 0.5, h); c.stroke(); }
    }
  }

  // ---- knobs: guarded paint (survives morph/swap) + window-drag ----
  function arcPath(cx, cy, r, a0, a1) {
    const p = a => { const rad = a * Math.PI / 180; return [cx + r * Math.cos(rad), cy + r * Math.sin(rad)]; };
    const [x0, y0] = p(a0), [x1, y1] = p(a1);
    const big = (a1 - a0) > 180 ? 1 : 0;
    return 'M ' + x0.toFixed(1) + ' ' + y0.toFixed(1) + ' A ' + r + ' ' + r + ' 0 ' + big + ' 1 ' + x1.toFixed(1) + ' ' + y1.toFixed(1);
  }
  function knobPaint(sp, get, lo, hi, fmt, curveV) {
    const dl = $('[data-sp-dial="' + sp + '"]'); if (!dl) return;
    const val = dl.querySelector('.sp-dial-value'),
          ptr = dl.querySelector('.sp-dial-pointer'),
          rk  = $('[data-sp="read-' + sp + '"]');
    const rv = clamp(curveV ? curveV(get()) : (get() - lo) / (hi - lo), 0, 1);
    const a = 225 + rv * 270, rad = a * Math.PI / 180;
    const x2 = (19 + 14 * Math.cos(rad)).toFixed(1),
          y2 = (19 + 14 * Math.sin(rad)).toFixed(1),
          d  = arcPath(19, 19, 14, 225, a);
    if (val && val.getAttribute('d') !== d) val.setAttribute('d', d);
    if (ptr && ptr.getAttribute('x2') !== x2) ptr.setAttribute('x2', x2);
    if (ptr && ptr.getAttribute('y2') !== y2) ptr.setAttribute('y2', y2);
    const txt = fmt(get());
    if (rk && rk.textContent !== String(txt)) rk.textContent = String(txt);
  }
  // gain: dial v -> db(-60..+6, 0dB at .75) -> amp; amp <-> db via log/exp
  const GAIN = {
    get: () => () => gain,
    set: () => v => { gain = ampFromDB(gainDBRo(v)); },
    norm: a => gainV(clamp(dbFromAmp(a), -60, 6)),
    fmt: a => { const db = clamp(dbFromAmp(a), -60, 6); if (db <= -59) return '-inf'; return (db >= 0 ? '+' : '') + db.toFixed(1) + 'db'; }
  };
  const KNOBS = [
    ['gain',   GAIN.get(), GAIN.set(), 0, 1, GAIN.fmt, GAIN.norm],
    ['semi',   () => semi,   v => semi   = Math.round(-12 + v * 24), -12, 12, s => (s >= 0 ? '+' : '') + s, null],
    ['fadein', () => fadeIn, v => fadeIn = v * 5, 0, 5, x => Math.round(x * 1000) + 'ms', null],
    ['fadeout',() => fadeOut,v => fadeOut= v * 5, 0, 5, x => Math.round(x * 1000) + 'ms', null],
    ['attack', () => attack, v => attack = v * 5, 0, 5, x => Math.round(x * 1000) + 'ms', null],
    ['decay',  () => decay,  v => decay  = v * 5, 0, 5, x => Math.round(x * 1000) + 'ms', null],
    ['sustain',() => sustain,v => sustain= v,      0, 1, x => x.toFixed(2), null],
    ['release',() => release,v => release= v * 5, 0, 5, x => Math.round(x * 1000) + 'ms', null],
    ['voices', () => voices, v => voices = clamp(Math.round(1 + v * 63), 1, 64), 1, 64, x => String(x), null],
    ['sens',   () => sensVal, v => sensVal = clamp(Math.round(v * 100), 0, 100), 0, 100, x => String(x) + '%', null]
  ];
  function startKnobDrag(sp, el, ev) {
    const k = KNOBS.find(kx => kx[0] === sp); if (!k) return;
    const [, get2, set2, lo, hi, fmt, curveV] = k;
    ev.preventDefault();
    const norm = () => { const rv = curveV ? curveV(get2()) : (get2() - lo) / (hi - lo); return rv; };
    const drag = { id: ev.pointerId, y0: ev.clientY, v0: norm() };
    const apply = m => { if (!drag || m.pointerId !== drag.id) return; const rv = clamp(drag.v0 + (drag.y0 - m.clientY) / 60, 0, 1); set2(rv); knobPaint(k[0], get2, lo, hi, fmt, curveV); };
    const end = m => { if (!drag || m.pointerId !== drag.id) return; window.removeEventListener('pointermove', apply); window.removeEventListener('pointerup', end); window.removeEventListener('pointercancel', end); if (alive()) persist(); };
