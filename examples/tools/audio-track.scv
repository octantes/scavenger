      setOn($('[data-at="arm"]'), 'on', true);
      persistMixer();
      recTake = null;
      beginCapture('rec ' + (++recN));
    }, delay);
  }

  function makeRow(t, i) {
    const rows = $('.at-rows'); if (!rows) return;
    const addEl = $('[data-at="add"]');
    const row = document.createElement('div');
    row.className = 'at-row'; row.dataset.i = i;
    const pp = document.createElement('button');
    pp.type = 'button'; pp.className = 'at-pp'; pp.dataset.at = 'pp'; pp.innerHTML = ICON.play;
    const name = document.createElement('span');
    name.className = 'at-tname'; name.textContent = t.name || NAME_OF(t.url);
    const rm = document.createElement('button');
    rm.type = 'button'; rm.className = 'at-rm'; rm.dataset.at = 'rm'; rm.title = 'remove'; rm.innerHTML = ICON.x;
    row.append(pp, name, rm);
    if (addEl) rows.insertBefore(row, addEl);
    else rows.appendChild(row);
  }

  function rebuildRows() {
    const rows = $('.at-rows'); if (!rows) return;
    rows.querySelectorAll('.at-row').forEach(r => r.remove());
    takes.forEach((t, i) => makeRow(t, i));
    if (recTake != null) markRow(recTake, recording);
  }

  function setRowIcons() {
    const rows = $('.at-rows'); if (!rows) return;
    rows.querySelectorAll('.at-row').forEach((row, i) => {
      const pp = row.querySelector('.at-pp');
      if (!pp) return;
      const icon = (i === current && playing) ? ICON.pause : ICON.play;
      if (pp.innerHTML !== icon) pp.innerHTML = icon;
    });
  }

  function meterFrame() {
    if (!playing || !analyser) return;
    analyser.getByteTimeDomainData(freq);
    let l = 0, r = 0, n = freq.length;
    for (let i = 0; i < n; i++) { const v = (freq[i] - 128) / 128, a = v * v; if (i < n / 2) l += a; else r += a; }
    const bL = $('[data-at="barL"]'), bR = $('[data-at="barR"]');
    if (bL) bL.style.height = Math.max(2, Math.min(100, Math.sqrt(l / (n / 2)) * vol * 1.4 * 100)) + '%';
    if (bR) bR.style.height = Math.max(2, Math.min(100, Math.sqrt(r / (n / 2)) * vol * 1.4 * 100)) + '%';
    raf = requestAnimationFrame(meterFrame);
  }
  function startMeter() { cancelAnimationFrame(raf); raf = requestAnimationFrame(meterFrame); }
  function stopMeter() {
    cancelAnimationFrame(raf);
    const bL = $('[data-at="barL"]'), bR = $('[data-at="barR"]');
    if (bL) bL.style.height = '0%'; if (bR) bR.style.height = '0%';
  }

  function drawCaret() {
    const c = $('[data-at="caret"]'); if (!c) return;
    const h = 120;
    const v = clamp(vol * (h - 6), 0, h - 2) + 'px';
    if (c.style.bottom !== v) c.style.bottom = v;
  }
  function drawPan() {
    const ptr = $('[data-at="panPtr"]'), arc = $('[data-at="panArc"]');
    if (!ptr || !arc) return;
    const a = (pan + 1) / 2 * Math.PI - Math.PI / 2;
    const x2 = 28 + 22 * Math.sin(a), y2 = 28 - 22 * Math.cos(a);
    const da = ((pan + 1) / 2) * HALF + ' ' + (HALF * 2);
    if (ptr.getAttribute('x2') !== String(x2)) ptr.setAttribute('x2', x2);
    if (ptr.getAttribute('y2') !== String(y2)) ptr.setAttribute('y2', y2);
    if (arc.getAttribute('stroke-dasharray') !== da) arc.setAttribute('stroke-dasharray', da);
  }

  let fDrag = null, pDrag = null;
  root.addEventListener('pointerdown', e => {
    const caretEl = e.target && e.target.closest ? e.target.closest('[data-at="caret"]') : null;
    if (caretEl) {
      fDrag = { id: e.pointerId, y0: e.clientY, v0: vol };
      e.preventDefault();
      try { caretEl.setPointerCapture(e.pointerId); } catch {}
      return;
    }
    const panEl = e.target && e.target.closest ? e.target.closest('[data-at="pan"]') : null;
    if (panEl) {
      pDrag = { id: e.pointerId, y0: e.clientY, v0: pan };
      try { panEl.setPointerCapture(e.pointerId); } catch {}
      return;
    }
  });
  root.addEventListener('pointermove', e => {
    if (fDrag && e.pointerId === fDrag.id) {
      const h = 120;
      vol = clamp(fDrag.v0 - (e.clientY - fDrag.y0) / (h - 6), 0, 1);
      if (outGain) outGain.gain.value = vol;
      drawCaret();
      return;
    }
    if (pDrag && e.pointerId === pDrag.id) {
      pan = clamp(pDrag.v0 + (pDrag.y0 - e.clientY) / 30, -1, 1);
      if (panner) panner.pan.value = pan;
      drawPan();
      return;
    }
  });
  root.addEventListener('pointerup', e => {
    if (fDrag && e.pointerId === fDrag.id) { fDrag = null; persistMixer(); return; }
    if (pDrag && e.pointerId === pDrag.id) { pDrag = null; persistMixer(); }
  });
  root.addEventListener('pointercancel', e => {
    if (fDrag && e.pointerId === fDrag.id) { fDrag = null; persistMixer(); }
    if (pDrag && e.pointerId === pDrag.id) { pDrag = null; persistMixer(); }
  });

  root.addEventListener('dblclick', e => {
    const panEl = e.target && e.target.closest ? e.target.closest('[data-at="pan"]') : null;
    if (panEl) { e.preventDefault(); pan = 0; if (panner) panner.pan.value = pan; drawPan(); persistMixer(); return; }
    const nm = e.target && e.target.closest ? e.target.closest('.at-tname') : null;
    if (!nm) return;
    const row = nm.closest('.at-row'); if (!row) return;
    const i = Number(row.dataset.i); if (!(takes[i] && Number.isInteger(i))) return;
    const inp = document.createElement('input');
    inp.className = 'at-tname editing'; inp.value = nm.textContent; inp.type = 'text';
    nm.replaceWith(inp); inp.focus(); inp.select();
    const commit = () => { takes[i].name = inp.value.trim() || NAME_OF(takes[i].url); nm.textContent = takes[i].name; inp.replaceWith(nm); persistTakes(); };
    inp.addEventListener('blur', commit);
    inp.addEventListener('keydown', ev => { if (ev.key === 'Enter') { ev.preventDefault(); commit(); } if (ev.key === 'Escape') { inp.replaceWith(nm); } });
  });

  root.addEventListener('click', e => {
    const addEl = e.target && e.target.closest ? e.target.closest('[data-at="add"]') : null;
    if (addEl) {
      if (recording) { stopRec(); return; }
      if (arm) startRec();
      else { const f = $('[data-at="file"]'); if (f) f.click(); }
      return;
    }
    const armEl = e.target && e.target.closest ? e.target.closest('[data-at="arm"]') : null;
    if (armEl) { armOnTap(); return; }
    const rm = e.target && e.target.closest ? e.target.closest('[data-at="rm"]') : null;
    if (rm) { const row = rm.closest('.at-row'); if (row) removeTake(Number(row.dataset.i)); return; }
    const pp = e.target && e.target.closest ? e.target.closest('[data-at="pp"]') : null;
    if (pp) { const row = pp.closest('.at-row'); if (row) playTake(Number(row.dataset.i)); return; }
  });
  root.addEventListener('change', e => {
    const f = e.target && e.target.dataset && e.target.dataset.at === 'file' ? e.target : null;
    if (!f) return;
    const file = f.files[0];
    if (file && file.type.startsWith('audio/')) toDataURL(file).then(url => { takes.push({ name: file.name, url, id: genId() }); rebuildRows(); persistTakes(); hydrate(); });
    f.value = '';
  });

  root.addEventListener('scv-receive', e => {
    const p = e.target && e.target.closest ? e.target.closest('[data-scv-receives]') : null;
    if (!p) return;
    const chs = (p.getAttribute('data-scv-receives') || '').trim().split(/[\s,]+/).filter(Boolean);
    const has = n => chs.some(t => t === n || t.indexOf(n + '_') === 0);
    const v = e.detail; // nothing in this system ever wraps a value - use the received payload as-is
    if (has('in') && v && v.kind === 'cmd') {
      const c = v;
      if (typeof c.t !== 'string') return;
      const now = ac ? ac.currentTime : 0;
      const tt = Number(c.targetTime);
      const tgt = Number.isFinite(tt) && tt > now + 0.001 ? tt : undefined;
      if (c.t === 'start') {
        ensureAC();
        if (c.rec) pendingStartAwait = true; // guard the count-in window - transport's own not-yet-playing ticks must not cancel a scheduled capture
        resume().then(() => {
          if (!takes.length) return;
          if (playing) stopSrc();
          current = current < 0 ? 0 : current;
          playing = true;
          pendingStartAwait = true;
          setRowIcons(); startMeter();
          startTakeBuffer(current, 0, Number.isFinite(tgt) ? tgt : ac.currentTime + 0.05);
        });
        if (c.rec) scheduleCapture(tgt);
      } else if (c.t === 'stop') {
        recCancel = true;
        if (recTimer) { clearTimeout(recTimer); recTimer = null; }
        pendingStartAwait = false;
        if (recording) stopRec();
        pauseTake();
      } else if (c.t === 'reset') {
        recCancel = true;
        if (recTimer) { clearTimeout(recTimer); recTimer = null; }
        pendingStartAwait = false;
        if (recording) stopRec();
        stopSrc(); playing = false;
        current = takes.length ? 0 : -1;
        setRowIcons(); stopMeter();
      } else if (c.t === 'rec') {
        scheduleCapture(tgt);
      } else if (c.t === 'recOff') {
        recCancel = true;
        if (recTimer) { clearTimeout(recTimer); recTimer = null; }
        if (recording) stopRec();
      }
      return;
    }
    if (has('in') && v && v.kind === 'transport') {
      const env = v;
      if (typeof env.play !== 'undefined' && !env.play && !pendingStartAwait) {
        recCancel = true;
        if (recTimer) { clearTimeout(recTimer); recTimer = null; }
        if (recording) stopRec();
        if (playing) pauseTake();
      }
      return;
    }
  });

  function syncUI() {
    applyScope();
    const rows = $('.at-rows'); if (!rows) return;
    if (rows.querySelectorAll('.at-row').length !== takes.length) rebuildRows();
    drawCaret(); drawPan(); setRowIcons();
    setOn($('[data-at="arm"]'), 'on', arm);
    setOn($('[data-at="add"]'), 'rec', recording);
  }

  if (!window.__SCAV_SYNC__ && typeof MutationObserver === 'function') {
    window.__SCAV_SYNC__ = (root, syncFn) => {
      let t = null;
      new MutationObserver(() => {
        clearTimeout(t);
        t = setTimeout(() => { try { syncFn(); } catch (e) { console.error('scav sync', e); } }, 0);
      }).observe(root, { subtree: true, childList: true, attributes: true, attributeFilter: ['data-scv-emits', 'data-scv-receives', 'class'] });
    };
  }
  __SCAV_SYNC__(root, syncUI);

  if (!window.__SCAV_LIFE__) {
    const lifeStop = new WeakMap(), lifeLive = new Set();
    let lifeOb = null;
    const lifeWalk = (n, add) => {
      if (n.nodeType !== 1) return false;
      let hit = false;
      if (lifeStop.has(n)) {
        hit = true;
        if (add) lifeLive.add(n);
        else if (lifeLive.has(n)) {
          lifeLive.delete(n);
          try { lifeStop.get(n)(); } catch (e) { console.error('scav teardown', e); }
        }
      }
      for (const c of n.children) if (lifeWalk(c, add)) hit = true;
      return hit;
    };
    window.__SCAV_LIFE__ = (host, stopFn) => {
      lifeStop.set(host, stopFn);
      if (host.isConnected) lifeLive.add(host);
      if (lifeOb) return;
      lifeOb = new MutationObserver(ms => {
        let d = false;
        for (const m of ms) {
          for (const n of m.addedNodes) d = lifeWalk(n, true) || d;
          for (const n of m.removedNodes) d = lifeWalk(n, false) || d;
        }
        if (d && !lifeLive.size) try { const a = window.__SCAV_AC__; if (a && a.state === 'running') a.suspend(); } catch {}
      });
      lifeOb.observe(document, { childList: true, subtree: true });
    };
  }
  __SCAV_LIFE__(host, () => {
    recCancel = true;
    if (recTimer) { clearTimeout(recTimer); recTimer = null; }
    pendingStartAwait = false;
    stopSrc();
    if (recording) { try { if (mediaRec && mediaRec.state !== 'inactive') mediaRec.stop(); } catch (e) {} recording = false; }
    if (stream) { try { stream.getTracks().forEach(tK => tK.stop()); } catch (e) {} stream = null; mediaRec = null; }
    cancelAnimationFrame(raf);
    playing = false; current = -1;
    syncUI();
  });

  function render() {
    const slotEl = $('[data-scv-slot="takes"]'); if (!slotEl) return;
    const parts = slotEl.value.split('\n').map(s => s.trim());
    takes = [];
    let pending = '', oldMix = null, inState = false;
    for (const p of parts) {
      if (p === '--') { inState = true; continue; }
      if (inState) { oldMix = p; continue; }
      if (p.indexOf('\t') !== -1) {
        const parts2 = p.split('\t');
        const nm = parts2[0], url = parts2[1], id = parts2[2];
        if (url && url.indexOf('data:') === 0) takes.push({ name: nm, url, id: id || genId() });
      } else pending = p;
    }
    if (!takes.length && pending && pending.indexOf('data:') === 0) takes.push({ name: '', url: pending, id: genId() });
    const mixerEl = $('[data-scv-slot="mixer"]');
    let mm = '';
    if (mixerEl && mixerEl.value.trim()) mm = mixerEl.value;
    else if (oldMix) mm = oldMix;
    const mmp = mm ? mm.split('|') : [];
    vol = clamp(parseFloat(mmp[0]), 0, 1); if (!isFinite(vol)) vol = 0.72;
    pan = clamp(parseFloat(mmp[1]), -1, 1); if (!isFinite(pan)) pan = 0;
    arm = mmp[2] === '1';
    if (current >= takes.length) current = -1;
    if (outGain) outGain.gain.value = vol;
    if (panner) panner.pan.value = pan;
    persistMixer();
    hydrate();
    syncUI();
  }

  function boot() { render(); syncUI(); }
  boot();
  requestAnimationFrame(boot);
  setTimeout(boot, 0);
}
connectedCallback() { this.setAttribute('data-scv-emitter', ''); } });
</script>
</body></html>