<!DOCTYPE html>  <!-- scavenge.ar - © 2026 octantes.ar - SPDX-License-Identifier: Apache-2.0 -->
<html><head><meta charset="utf-8"><title>scv-color - scav component</title><link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2016%2016%22%3E%3Ctext%20x%3D%228%22%20y%3D%2212%22%20font-size%3D%2211%22%20font-family%3D%22monospace%22%20fill%3D%22%23986c98%22%20text-anchor%3D%22middle%22%3E%26lt%3B%26gt%3B%3C%2Ftext%3E%3C%2Fsvg%3E"></head>
<body style="margin:0;background:#1a1c1c">
<scv-color data-scv-component></scv-color>
<script data-scv-comp data-scv-tag="scv-color" data-scv-source="" data-scv-icon="">
customElements.define('scv-color', class extends HTMLElement { constructor() { super();
const _baked = !this.shadowRoot && this.querySelector('template[shadowrootmode], template.custom-shadow');
if (_baked) { this.attachShadow({mode: 'open'}).innerHTML = _baked.innerHTML; _baked.remove(); }
else if (!this.shadowRoot) this.attachShadow({mode: 'open'}).innerHTML = `<style>.cc { display:flex; align-items:center; gap:10px; padding:12px 14px; background:#252727; border-radius:5px; font:13px 'SF Mono',ui-monospace,monospace; color:#AAABAC; }
  .cc input[type=color] { width:16px; height:16px; border:0; background:none; padding:0; cursor:pointer; }
  .cc input[type=color]::-webkit-color-swatch { border:0; border-radius:4px; }
  .cc input[type=color]::-webkit-color-swatch-wrapper { padding:0; }
  .cc .hex { color:#8AB6BB; text-transform:uppercase; }</style><div class="cc">
  <input type="color" value="#8AB6BB" data-scv-slot="color">
  <span class="hex" data-scv-slot="hex">#8AB6BB</span>
</div>`;
const root = this.shadowRoot, host = this, emit = v => this.dispatchEvent(new CustomEvent('scv-emit', { detail: v, bubbles: true, composed: true }));
const c = root.querySelector('input');
  c.addEventListener('input', () => { root.querySelector('[data-scv-slot=hex]').textContent = c.value; emit(c.value); });
}
connectedCallback() { this.setAttribute('data-scv-emitter', ''); } });
</script>
</body></html>