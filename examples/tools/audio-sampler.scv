  .sp-knob-label { font-size: 8px; letter-spacing: 1px; color: var(--text-dim, #888); text-transform: uppercase; }
  .sp-knob-read { font-size: 9px; color: var(--input, #8AB6BB); min-width: 44px; text-align: center; }
  .sp-dial { position: relative; width: 38px; height: 38px; cursor: ns-resize; touch-action: none; }
  .sp-dial svg { display: block; width: 38px; height: 38px; overflow: visible; pointer-events: none; }
  .sp-dial svg * { pointer-events: none; }

  .sp-btn { display: flex; align-items: center; justify-content: center; box-sizing: border-box; height: 24px; border: none; border-radius: var(--corner-low, 5px); background: var(--background-sunk, #1A1C1C); color: var(--text-base, #AAABAC); font: 9px var(--font-mono, ui-monospace, monospace); text-transform: uppercase; letter-spacing: 1px; cursor: pointer; padding: 0 8px; }
  .sp-btn:hover { color: var(--input, #8AB6BB); }
  .sp-btn.on { background: var(--output, #986C98); color: var(--background-sunk, #1A1C1C); }
