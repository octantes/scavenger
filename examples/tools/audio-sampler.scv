const root = this.shadowRoot, host = this, emit = v => this.dispatchEvent(new CustomEvent('scv-emit', { detail: v, bubbles: true, composed: true }));
const $ = s => root.querySelector(s);
  const portEmit = (ch, v) => {
    // authored emit() dispatches from the host, so patchbay's drag-wire (which always snaps an authored
    // component's wire to its host) actually fires it - one real channel, not one dot per signal
    emit((v && typeof v === 'object' && v.constructor === Object) ? { kind: ch, ...v } : { kind: ch, value: v });
  };
  const PRISTINE = /^[a-z][a-z-]*$/;
  const scopeTok = () => {
    const raw = (host.dataset.scvId || '').replace('comp_', '').replace('imp_', '').replace('live_', '');
    if (/^[a-z0-9]{4,}$/i.test(raw)) return raw.slice(-6);
    return host._scavScope || (host._scavScope = Math.random().toString(36).slice(2, 8));
  };
  const TOK = scopeTok();
  const scopeCh = ch => /^ch_p/.test(ch) ? ch : PRISTINE.test(ch) ? ch + '_' + TOK : ch;
  const scopeAttr = (el, name) => {
    const a = el.getAttribute(name);
    if (!a) return;
    const sc = a.split(/[\s,]+/).map(scopeCh).join(' ');
    if (sc !== a) el.setAttribute(name, sc);
  };
  function applyScope() {
    root.querySelectorAll('[data-scv-emits],[data-scv-receives]').forEach(el => { scopeAttr(el, 'data-scv-emits'); scopeAttr(el, 'data-scv-receives'); });
  }

  const setOn  = (el, c, on) => { if (el && el.classList.contains(c) !== !!on) el.classList.toggle(c, !!on); };
  const setTxt = (el, t) => { if (el && el.textContent !== String(t)) el.textContent = String(t); };
  const setVal = (el, v) => { if (el && el.value !== String(v)) el.value = String(v); };

  let clip = null;
  let mode = 'classic', warp = 're-pitch';
  let gain = 1.0, attack = 0.005, decay = 0.1, sustain = 0.8, release = 0.2;
  let fadeIn = 0.01, fadeOut = 0.01, sensVal = 50, semi = 0;
  let clipStart = 0, clipEnd = 1;
  let slices = [], autoSlices = [];
  let rootNote = 60, bpm = 120, voices = 4, curKey = null;
  let viewStart = 0, viewSpan = 1, waveStatic = null;
  const STATIC_W = 2048;
  let ac = null, outGain = null, voicesActive = [];
  let kbOn = false, kbOct = 4;
  const held = {};
  let transportEnv = null, beatQ = [], beatTimer = null, beatToken = 0;

  const alive = () => { const fr = $('[data-sp="frame"]'); return !!(fr && fr.isConnected); };
  const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
  const toDataURL = blob => new Promise((res, rej) => { const r = new FileReader(); r.onload = () => res(r.result); r.onerror = rej; r.readAsDataURL(blob); });
  const dataUrlToArrayBuffer = url => fetch(url).then(r => r.arrayBuffer());

  function ensureAC() {
    if (ac && ac.state !== 'closed') return ac;
    ac = undefined;
    if (!window.__SCAV_AC__ || window.__SCAV_AC__.state === 'closed') window.__SCAV_AC__ = new (window.AudioContext || window.webkitAudioContext)();
    ac = window.__SCAV_AC__;
    outGain = ac.createGain();
    outGain.gain.value = gain;
    outGain.connect(ac.destination);
    return ac;
  }
  function resume() { ensureAC(); if (ac.state === 'suspended') return ac.resume(); return Promise.resolve(); }

  // ---- Ableton-style gain: dB display, amp storage (0dB default == amp 1.0, +6dB full) ----
  // dial v in [0,1] -> db in [-60, +6], 0dB rests at ~0.75 rotation
  const gainDB = v => 6 - 60 * Math.pow(1 - v, 1.65);
  const gainV = db => 1 - Math.pow((6 - db) / 60, 1 / 1.65);
  const ampFromDB = db => Math.pow(10, db / 20);
  const dbFromAmp = a => a <= 0 ? -120 : 20 * Math.log10(a);
  const gainDBRo = v => { const db = Math.max(-60, Math.min(6, 6 - 60 * Math.pow(1 - v, 1.65))); return db; };

  function detectTransients() {
    autoSlices = [];
    if (!clip || sensVal <= 0) return;
    const data = clip.getChannelData(0), len = data.length, sr = clip.sampleRate;
    const winSize = Math.max(1, Math.round(sr * 0.01)), hopSize = Math.max(1, Math.round(sr * 0.005));
    const nFrames = Math.floor((len - winSize) / hopSize) + 1;
    if (nFrames < 3) return;
    const env = new Float32Array(nFrames);
    for (let f = 0; f < nFrames; f++) { const o = f * hopSize; let s = 0; for (let j = o; j < o + winSize; j++) s += data[j] * data[j]; env[f] = Math.sqrt(s / winSize); }
    const onset = new Float32Array(nFrames);
    for (let f = 1; f < nFrames; f++) onset[f] = Math.max(0, env[f] - env[f - 1]);
    let mx = 0; for (let f = 0; f < nFrames; f++) if (onset[f] > mx) mx = onset[f];
    if (mx === 0) return;
    const thr = mx * (1.0 - clamp(sensVal, 1, 100) / 100 * 0.95);
    const md = Math.max(1, Math.round(sr * 0.03 / hopSize));
    const pk = [];
    for (let f = 1; f < nFrames - 1; f++) if (onset[f] > thr && onset[f] >= onset[f - 1] && onset[f] >= onset[f + 1]) if (!pk.length || f - pk[pk.length - 1] >= md) pk.push(f);
    autoSlices = pk.map(f => f * hopSize / len);
  }
  function setClip(buf) {
    clip = buf; clipStart = 0; clipEnd = 1; slices = []; detectTransients(); waveStatic = null;
    if (curKey) loadSetup();
    applyVisibility();
    emitLive(); redraw();
  }
  function loadUrl(url) { dataUrlToArrayBuffer(url).then(b => ac.decodeAudioData(b)).then(setClip).catch(e => { console.error(e); }); }

  // ---- region-relative slice reachability ----
  const inRegion = f => f > clipStart && f < clipEnd;
  function currentSlices() {
    if (slices.length) return slices.filter(inRegion).map(f => (f - clipStart) / (clipEnd - clipStart));
    if (autoSlices.length) return autoSlices.filter(inRegion).map(f => (f - clipStart) / (clipEnd - clipStart));
    return [];
  }
  function reachToStored(relIdx) {
    let n = -1;
    for (let i = 0; i < slices.length; i++) { if (inRegion(slices[i])) { n++; if (n === relIdx) return i; } }
    return -1;
  }

  function killVoice(v) {
    try { v.src.stop(); } catch {}
    try { v.envGain.disconnect(); } catch {}
    const i = voicesActive.indexOf(v); if (i >= 0) voicesActive.splice(i, 1);
  }
  function killAll() { for (const v of voicesActive.slice()) killVoice(v); voicesActive = []; }
  function lastVoice() { return voicesActive[voicesActive.length - 1] || null; }

  function noteOn(note, velocity, time) {
    if (!alive() || !clip) return; ensureAC();
    while (voicesActive.length >= Math.max(1, voices)) killVoice(voicesActive[0]);
    const sr = clip.sampleRate;
    const isSlice = mode === 'slice';
    const oneshot = mode === 'oneshot';
    let cs = Math.floor(clipStart * clip.length), ce = Math.floor(clipEnd * clip.length), loop = false, playToEnd = false;
    let rate;
    if (isSlice) {
      const rel = currentSlices();
      const idx = clamp(note - rootNote, 0, rel.length - 1);
      const lag = Math.max(rel.length - 1, 0);
      const span = clipEnd - clipStart;
      cs = Math.floor((clipStart + rel[idx] * span) * clip.length);
      ce = idx < lag ? Math.floor((clipStart + rel[idx + 1] * span) * clip.length) : Math.floor(clipEnd * clip.length);
      loop = false; playToEnd = false;
      rate = Math.pow(2, semi / 12);
    } else if (oneshot) {
      playToEnd = true; loop = false;
      rate = Math.pow(2, (note - rootNote + semi) / 12);
    } else {
      loop = true;
      rate = Math.pow(2, (note - rootNote + semi) / 12);
    }
    if (ce <= cs) ce = cs + 1;
    const amp = gain * (velocity / 127);
    const env = ac.createGain(); env.gain.value = 0; env.connect(outGain);
    const t = Math.max(ac.currentTime, time || 0);
    const atk = Math.max(0.001, attack), dec = Math.max(0.001, decay), sus = Math.max(0.001, sustain);
    const offset = cs / sr, endTime = ce / sr, dur = (ce - cs) / sr;
    const g = env.gain;
    g.setValueAtTime(0, t);
    g.linearRampToValueAtTime(amp, t + atk);
    g.linearRampToValueAtTime(amp * sus, t + atk + dec);
    if (playToEnd) {
      const fo = Math.max(0.001, Math.min(fadeOut, dur * 0.5));
      g.linearRampToValueAtTime(0.0001, t + atk + dec + Math.max(0.001, dur - atk - dec) - fo);
    }
    let src = ac.createBufferSource(); src.buffer = clip;
    src.playbackRate.value = rate;
    src.loop = loop;
    if (loop) { src.loopStart = offset; src.loopEnd = endTime; }
    src.connect(env);
    src.start(t, offset, (loop || playToEnd) ? (playToEnd ? dur : undefined) : dur);
    const voice = { src, envGain: env, amp, oneshot: playToEnd, loop, cs, ce, startT: t };
    src.onended = () => { const i = voicesActive.indexOf(voice); if (i >= 0) voicesActive.splice(i, 1); try { voice.envGain.disconnect(); } catch {} };
    voicesActive.push(voice);
