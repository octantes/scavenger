    if (e.button === 1) { dMode = 'pan'; dX = e.clientX; e.preventDefault(); try { fr.setPointerCapture(e.pointerId); } catch {} return; }
    if (!clip) return;
    const rect = fr.getBoundingClientRect(); const x = e.clientX - rect.left, cw = fr.clientWidth;
    dX = e.clientX; dY = e.clientY; dVSpan = viewSpan; dRatio = x / cw; dAnchor = viewStart + dRatio * viewSpan;
    const sx = XT(clipStart), ex = XT(clipEnd);
    dMode = null; dF = -1;
    if (Math.abs(x - sx) < 12) dMode = 'start';
    else if (Math.abs(x - ex) < 12) dMode = 'end';
