  .sp-oct { width: 60px; height: 24px; display: flex; align-items: center; justify-content: center; font-size: 11px; color: var(--input, #8AB6BB); box-sizing: border-box; }

  .sp-knobs { display: flex; gap: 10px; align-items: flex-start; flex-wrap: nowrap; white-space: nowrap; }
