    const lines = takes.map(t => (t.name || '') + '\t' + t.url + '\t' + (t.id || (t.id = genId())));
    s.value = lines.join('\n');
  }

  function hydrate() {
    blobUrls.forEach(u => { try { URL.revokeObjectURL(u); } catch (e) {} });
    blobUrls = new Set();
    takes.forEach(t => {
      t.buf = null;
      if (t.url && t.url.indexOf('data:') === 0) {
        fetch(t.url).then(r => r.blob()).then(b => {
          const u = URL.createObjectURL(b);
          blobUrls.add(u);
          t.buf = u;
        }).catch(() => {});
      }
    });
  }

  function emitLive(buf) { portEmit('audio', buf); }
  function emitURL() { if (current >= 0) portEmit('take-url', takes[current].url); }
  function emitID() { if (current >= 0) portEmit('take-id', takes[current].id || (takes[current].id = genId())); }

  function stopSrc() {
    if (srcNode) { try { srcNode.onended = null; srcNode.stop(); } catch (e) {} try { srcNode.disconnect(); } catch (e) {} srcNode = null; }
  }

