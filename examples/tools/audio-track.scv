      recording = true;
      if (recTake != null) markRow(recTake, true);
      setHtml($('[data-at="add"]'), ICON.stop);
      setOn($('[data-at="add"]'), 'rec', true);
    }).catch(err => console.error('capture denied', err));
  }
  function endCapture() {
    if (mediaRec && mediaRec.state !== 'inactive') mediaRec.stop();
