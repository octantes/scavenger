  function resume() { ensureAC(); if (ac.state === 'suspended') return ac.resume(); return Promise.resolve(); }

  function persistMixer() { const s = $('[data-scv-slot="mixer"]'); if (s) s.value = vol + '|' + pan + '|' + (arm ? 1 : 0); }
  function persistTakes() {
