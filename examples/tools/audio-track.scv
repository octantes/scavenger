  }

  const setOn  = (el, c, on) => { if (el && el.classList.contains(c) !== !!on) el.classList.toggle(c, !!on); };
  const setHtml = (el, h) => { if (el && el.innerHTML !== h) el.innerHTML = h; };

  let takes = [];
  let current = -1, playing = false, liveRecv = false;
  let pendingStartAwait = false;
  let vol = 0.72, pan = 0, arm = false;
  let recN = 0;
  let ac = null, outGain = null, panner = null, analyser = null, freq = null, raf = 0;
  let srcNode = null;
  let recording = false, recTimer = null, recCancel = false, stream = null, mediaRec = null, recTake = null;
  let blobUrls = new Set();

  const HALF = Math.PI * 22;
  const ICON = {
    play: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>',
    pause: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zm6 0h4v14h-4z"></path></svg>',
    plus: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4h4v6h6v4h-6v6h-4v-6H4v-4h6z"></path></svg>',
    stop: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="6" width="12" height="12"></rect></svg>',
    x: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>'
  };

  const NAME_OF = u => { const m = /^data:([^;,]+)/.exec(u); const ext = m && m[1].includes('mpeg') ? 'mp3' : m && m[1].includes('ogg') ? 'ogg' : m && m[1].includes('wav') ? 'wav' : 'audio'; return 'take.' + ext; };
  const toDataURL = blob => new Promise((res, rej) => { const r = new FileReader(); r.onload = () => res(r.result); r.onerror = rej; r.readAsDataURL(blob); });
  const dataUrlToArrayBuffer = url => fetch(url).then(r => r.arrayBuffer());
  const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
  const genId = () => {
    if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
    return 't_' + Math.random().toString(36).slice(2) + Date.now().toString(36);
  };

  function ensureAC() {
    if (ac && ac.state !== 'closed') return ac;
    ac = undefined;
    if (!window.__SCAV_AC__ || window.__SCAV_AC__.state === 'closed') window.__SCAV_AC__ = new (window.AudioContext || window.webkitAudioContext)();
    ac = window.__SCAV_AC__;
    outGain = ac.createGain();
    panner = ac.createStereoPanner();
    analyser = ac.createAnalyser();
    analyser.fftSize = 256;
    freq = new Uint8Array(analyser.fftSize);
    outGain.connect(panner); panner.connect(ac.destination);
    outGain.connect(analyser);
    outGain.gain.value = vol;
    panner.pan.value = pan;
    return ac;
