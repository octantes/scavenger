  .sp-select { height: 24px; box-sizing: border-box; border: none; border-radius: var(--corner-low, 5px); background: var(--background-sunk, #1A1C1C); color: var(--text-base, #AAABAC); font: 9px var(--font-mono, ui-monospace, monospace); text-transform: uppercase; letter-spacing: 1px; padding: 0 6px; outline: none; cursor: pointer; display: none; }
  .sp-file-in { display: none; }
