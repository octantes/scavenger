  }
  // stop paths must work even when orphaned, so voices can be silenced after a recompile
  function noteOffAll() {
    if (!ac) return;
    const t = ac.currentTime, rel = Math.max(0.001, release);
    for (const v of voicesActive) {
      if (v.oneshot) continue;
      const g = v.envGain.gain; g.cancelScheduledValues(t);
      g.setValueAtTime(Math.max(v.amp * sustain, 0.0001), t); g.linearRampToValueAtTime(0.0001, t + rel);
      try { v.src.stop(t + rel + 0.01); } catch {}
      const i = voicesActive.indexOf(v); if (i >= 0) voicesActive.splice(i, 1);
    }
  }
  function emitLive() { if (alive() && clip) portEmit('audio', clip); }

  // ---- beat-quantized note queue (transport-in) ----
  function fireQueued(atTime) {
    if (!beatQ.length) return;
    const q = beatQ; beatQ = [];
    for (const n of q) noteOn(n.note, n.velocity, atTime);
  }
  function scheduleBeatFlush() {
    if (!beatQ.length || !ac || !transportEnv) return;
    const now = ac.currentTime;
    const next = Number(transportEnv.next);
    if (!Number.isFinite(next) || next <= now + 0.005) { fireQueued(); return; }
    const tk = ++beatToken;
    if (beatTimer) { clearTimeout(beatTimer); beatTimer = null; }
    beatTimer = setTimeout(() => { beatTimer = null; if (tk === beatToken) fireQueued(); }, Math.max(0, (next - now) * 1000 + 1));
  }

  function currentPlaySample() {
    const v = lastVoice();
    if (!v || !ac) return null;
    const sr = clip.sampleRate, elapsed = Math.max(0, ac.currentTime - v.startT);
    const len = Math.max(1, v.ce - v.cs);
    if (v.loop) return v.cs + (elapsed * sr % len);
    return Math.min(v.ce, v.cs + elapsed * sr);
  }

  // ---- waveform static buffer ----
  function buildStatic(w, h) {
    const W = STATIC_W;
    waveStatic = document.createElement('canvas'); waveStatic.width = W; waveStatic.height = h;
    const sc = waveStatic.getContext('2d');
    const data = clip.getChannelData(0), total = clip.length;
    const step = Math.max(1, Math.floor(total / (W * 2)));
    sc.fillStyle = 'rgba(0,0,0,0.25)'; sc.fillRect(0, 0, W, h);
    sc.strokeStyle = 'rgba(138,182,187,0.85)'; sc.lineWidth = 1;
    sc.beginPath();
    for (let x = 0; x < W; x++) {
      const s0 = Math.floor((x / W) * total), s1 = Math.floor(((x + 1) / W) * total) || s0 + 1;
      let mn = 1, mx = -1;
      for (let j = Math.max(0, s0); j < Math.min(total, s1); j += step) { const v = data[j]; if (v < mn) mn = v; if (v > mx) mx = v; }
      if (mn > mx) { mn = 0; mx = 0; } if (mx - mn < 0.02) { mn -= 0.01; mx += 0.01; }
      const mid = h * 0.5; sc.moveTo(x + 0.5, mid - mx * mid * 0.86); sc.lineTo(x + 0.5, mid - mn * mid * 0.86);
    }
    sc.stroke();
  }
  function applyVisibility() {
    const e = $('[data-sp="empty"]'), c = $('[data-sp="canvas"]');
    if (e && e.hidden !== !!clip) e.hidden = !!clip;
    if (c && c.hidden !== !clip) c.hidden = !clip;
  }
  function redraw() {
    const fr = $('[data-sp="frame"]'); if (!fr || !alive()) return;
    const cv = $('[data-sp="canvas"]'); if (!cv) return;
    applyVisibility();
    const w = fr.clientWidth, h = fr.clientHeight;
    if (!w || !h || !clip) return;
    cv.width = w; cv.height = h;
    const c = cv.getContext('2d');
    c.clearRect(0, 0, w, h);
    if (!waveStatic) buildStatic(w, h);
    const W = waveStatic.width;
    c.drawImage(waveStatic, viewStart * W, 0, viewSpan * W, h, 0, 0, w, h);
    const total = clip.length, sr = clip.sampleRate;
    const sStart = viewStart * total, sView = viewSpan * total, sEnd = sStart + sView;
    const spb = sr * (60 / clamp(bpm, 20, 300));
    const firstBeat = Math.ceil(sStart / spb), lastBeat = Math.floor(sEnd / spb);
    for (let b = firstBeat; b <= lastBeat; b++) {
      const x = ((b * spb - sStart) / sView) * w;
      c.strokeStyle = (b % 4 === 0) ? 'rgba(255,255,255,0.16)' : 'rgba(255,255,255,0.07)';
      c.lineWidth = 1; c.beginPath(); c.moveTo(x + 0.5, 0); c.lineTo(x + 0.5, h); c.stroke();
    }
    const X = f => ((f * total - sStart) / sView) * w;
    const flag = (f, dir) => {
      const x = X(f); if (x < -14 || x > w + 14) return;
      c.strokeStyle = '#986C98'; c.lineWidth = 1.5; c.beginPath(); c.moveTo(x + 0.5, 0); c.lineTo(x + 0.5, h); c.stroke();
      c.fillStyle = '#986C98';
      c.beginPath();
      if (dir === '>') { c.moveTo(x, 0); c.lineTo(x + 12, 0); c.lineTo(x + 12, 9); c.lineTo(x, 9); }
      else            { c.moveTo(x, 0); c.lineTo(x - 12, 0); c.lineTo(x - 12, 9); c.lineTo(x, 9); }
      c.closePath(); c.fill();
    };
    flag(clipStart, '>');
    flag(clipEnd, '<');
