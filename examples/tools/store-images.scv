<!DOCTYPE html>  <!-- scavenge.ar - © 2026 octantes.ar - SPDX-License-Identifier: Apache-2.0 -->
<html><head><meta charset="utf-8"><title>scv-store-images - scav component</title><link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2016%2016%22%3E%3Ctext%20x%3D%228%22%20y%3D%2212%22%20font-size%3D%2211%22%20font-family%3D%22monospace%22%20fill%3D%22%23986c98%22%20text-anchor%3D%22middle%22%3E%26lt%3B%26gt%3B%3C%2Ftext%3E%3C%2Fsvg%3E"></head>
<body style="margin:0;background:#1a1c1c">
<scv-store-images data-scv-component></scv-store-images>
<script data-scv-comp data-scv-tag="scv-store-images" data-scv-source="" data-scv-icon="">
customElements.define('scv-store-images', class extends HTMLElement { constructor() { super();
const _baked = !this.shadowRoot && this.querySelector('template[shadowrootmode], template.custom-shadow');
if (_baked) { this.attachShadow({mode: 'open'}).innerHTML = _baked.innerHTML; _baked.remove(); }
else if (!this.shadowRoot) this.attachShadow({mode: 'open'}).innerHTML = `<style>:host { display: block; }
  .ga { width: 260px; background: var(--background-raised, #252727); border: 1px solid var(--border, #3A3C3C); border-radius: var(--corner-high, 8px); padding: 8px 10px 10px; box-sizing: border-box; font-family: var(--font-mono, 'SF Mono', ui-monospace, monospace); }
  .ga-lab { color: var(--text-faint, #666666); font-size: 10px; text-transform: lowercase; letter-spacing: 1px; margin-bottom: 6px; }
  .ga-stage { display: flex; align-items: stretch; gap: 4px; margin-bottom: 4px; }
  .ga-nav { flex: none; width: 24px; background: var(--background-sunk, #1A1C1C); border: none; border-radius: var(--corner-low, 5px); color: var(--text-base, #AAABAC); font: 14px var(--font-mono, 'SF Mono', monospace); cursor: pointer; }
  .ga-nav:hover { color: var(--input, #8AB6BB); }
  .ga-thumb { position: relative; flex: 1; aspect-ratio: 1; border-radius: var(--corner-low, 5px); background: var(--background-sunk, #1A1C1C); overflow: hidden; }
  .ga-thumb img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; border: 0; outline: 0; }
  .ga-thumb img:not([src]) { display: none; }
  .ga-add { display: flex; gap: 4px; }
  .ga-input { flex: 1; min-width: 0; box-sizing: border-box; background: var(--background-sunk, #1A1C1C); border: none; border-radius: var(--corner-low, 5px); color: var(--text-dim, #888888); font: 10px var(--font-mono, 'SF Mono', monospace); padding: 6px 8px; outline: none; }
  .ga-input:focus { color: var(--text-base, #AAABAC); border-color: var(--input, #8AB6BB); }
  .ga-file { position: relative; flex: none; width: 24px; height: 24px; border: none; border-radius: var(--corner-low, 5px); background: var(--background-sunk, #1A1C1C); color: var(--input, #8AB6BB); font: 16px/1 var(--font-mono, 'SF Mono', monospace); display: flex; align-items: center; justify-content: center; cursor: pointer; }
  .ga-file:hover { border-color: var(--input, #8AB6BB); }
  .ga-file input[type=file] { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  textarea[hidden] { display: none; }</style><div class="ga">
  <div class="ga-lab" data-scv-slot="label">gallery</div>
  <div class="ga-stage">
    <button type="button" class="ga-nav" data-ga="prev">◀</button>
    <div class="ga-thumb">
      <img alt="" data-ga="img" data-scv-emits="">
    </div>
    <button type="button" class="ga-nav" data-ga="next">▶</button>
  </div>
  <div class="ga-add">
    <input type="text" class="ga-input" data-ga="paste" placeholder="paste an image here" spellcheck="false">
    <label class="ga-file" title="add image">+<input type="file" accept="image/*" data-ga="file"></label>
  </div>
  <textarea data-scv-slot="images" hidden=""></textarea>
</div>`;
const root = this.shadowRoot, host = this, emit = v => this.dispatchEvent(new CustomEvent('scv-emit', { detail: v, bubbles: true, composed: true }));
const imgEl = root.querySelector('[data-ga="img"]'), prev = root.querySelector('[data-ga="prev"]'),
        next = root.querySelector('[data-ga="next"]'), pasteIn = root.querySelector('[data-ga="paste"]'),
        fileIn = root.querySelector('[data-ga="file"]'), slot = root.querySelector('[data-scv-slot="images"]');
  let images = [];
  let idx = 0;
  const toDataURL = file => new Promise((res, rej) => { const r = new FileReader(); r.onload = () => res(r.result); r.onerror = rej; r.readAsDataURL(file); }); // same native path as patchbay
  function persist() { slot.value = images.join('\n'); }
  function show() {
    if (images.length === 0) { imgEl.removeAttribute('src'); return; }
    if (idx >= images.length) idx = 0; if (idx < 0) idx = images.length - 1;
    imgEl.setAttribute('src', images[idx]);
  }
  const emitCurrent = () => { if (images.length) imgEl.dispatchEvent(new CustomEvent('scv-emit', { detail: images[idx], bubbles: true, composed: true })); };
  prev.addEventListener('click', () => { if (images.length) { idx = (idx - 1 + images.length) % images.length; show(); emitCurrent(); } });
  next.addEventListener('click', () => { if (images.length) { idx = (idx + 1) % images.length; show(); emitCurrent(); } });
  imgEl.addEventListener('click', emitCurrent);
  pasteIn.addEventListener('paste', e => {
    const f = (e.clipboardData?.files || [])[0];
    if (f && f.type.startsWith('image/')) {
      e.preventDefault();
      toDataURL(f).then(url => { images.push(url); idx = images.length - 1; show(); persist(); });
    }
  });
  fileIn.addEventListener('change', () => {
    const f = fileIn.files[0];
    if (f && f.type.startsWith('image/')) toDataURL(f).then(url => { images.push(url); idx = images.length - 1; show(); persist(); });
    fileIn.value = '';
  });
  function render() {
    images = slot.value.split('\n').map(s => s.trim()).filter(Boolean);
    if (images.length) idx = Math.min(idx, images.length - 1);
    show();
  }
  function boot() { render(); }
  boot();
  requestAnimationFrame(boot);
  setTimeout(boot, 0);
}
connectedCallback() { this.setAttribute('data-scv-emitter', ''); } });
</script>
</body></html>