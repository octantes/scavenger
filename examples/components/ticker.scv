<!DOCTYPE html>  <!-- scavenge.ar - © 2026 octantes.ar - SPDX-License-Identifier: Apache-2.0 -->
<html><head><meta charset="utf-8"><title>scv-ticker - scav component</title><link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2016%2016%22%3E%3Ctext%20x%3D%228%22%20y%3D%2212%22%20font-size%3D%2211%22%20font-family%3D%22monospace%22%20fill%3D%22%23986c98%22%20text-anchor%3D%22middle%22%3E%26lt%3B%26gt%3B%3C%2Ftext%3E%3C%2Fsvg%3E"></head>
<body style="margin:0;background:#1a1c1c">
<scv-ticker data-scv-component></scv-ticker>
<script data-scv-comp data-scv-tag="scv-ticker" data-scv-source="" data-scv-icon="">
customElements.define('scv-ticker', class extends HTMLElement { constructor() { super();
const _baked = !this.shadowRoot && this.querySelector('template[shadowrootmode], template.custom-shadow');
if (_baked) { this.attachShadow({mode: 'open'}).innerHTML = _baked.innerHTML; _baked.remove(); }
else if (!this.shadowRoot) this.attachShadow({mode: 'open'}).innerHTML = `<style>.fr { font: 700 40px var(--font-mono, 'SF Mono', monospace); color: var(--text-base, #AAABAC); padding: 20px 30px; background: var(--background-raised, #252727); border: 1px solid var(--border, #3A3C3C); border-radius: var(--corner-high, 8px); text-align: center; transition: color .12s ease, border-color .12s ease; }
.fr.up { color: var(--success, #6FAC67); border-color: var(--success, #6FAC67); }
.fr.dn { color: var(--danger, #985954); border-color: var(--danger, #985954); }
.lbl { display: block; font-size: 11px; color: var(--text-dim, #888888); letter-spacing: 2px; margin-bottom: 8px; text-transform: uppercase; }</style><div class="fr"><span class="lbl" data-scv-slot="label">value</span><span data-scv-slot="value">—</span></div>`;
const root = this.shadowRoot, host = this, emit = v => this.dispatchEvent(new CustomEvent('scv-emit', { detail: v, bubbles: true, composed: true }));
const box = root.querySelector('.fr'), v = root.querySelector('[data-scv-slot=value]');
let prev = null;
host.addEventListener('scv-receive', e => {
  const val = e.detail; v.textContent = val;
  const num = parseFloat(String(val).replace(/[^0-9.]/g, ''));
  if (prev != null && !isNaN(num) && num !== prev) { box.classList.remove('up', 'dn'); void box.offsetWidth; box.classList.add(num >= prev ? 'up' : 'dn'); }
  if (!isNaN(num)) prev = num;
});
}
connectedCallback() { this.setAttribute('data-scv-emitter', ''); } });
</script>
</body></html>