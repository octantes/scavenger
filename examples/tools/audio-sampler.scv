      const rect = fr.getBoundingClientRect(), x = e.clientX - rect.left, cw = fr.clientWidth;
      const sx = ((clipStart - viewStart) / viewSpan) * cw, ex = ((clipEnd - viewStart) / viewSpan) * cw;
      fr.style.cursor = (Math.abs(x - sx) < 12 || Math.abs(x - ex) < 12 || sliceHit(x) >= 0) ? 'ew-resize' : 'crosshair'; return;
    }
