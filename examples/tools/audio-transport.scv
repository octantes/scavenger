<!DOCTYPE html>  <!-- scavenge.ar - © 2026 octantes.ar - SPDX-License-Identifier: Apache-2.0 -->
<html><head><meta charset="utf-8"><title>scv-audio-transport - scav component</title><link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2016%2016%22%3E%3Ctext%20x%3D%228%22%20y%3D%2212%22%20font-size%3D%2211%22%20font-family%3D%22monospace%22%20fill%3D%22%23986c98%22%20text-anchor%3D%22middle%22%3E%26lt%3B%26gt%3B%3C%2Ftext%3E%3C%2Fsvg%3E"></head>
<body style="margin:0;background:#1a1c1c">
<scv-audio-transport data-scv-component></scv-audio-transport>
<script data-scv-comp data-scv-tag="scv-audio-transport" data-scv-source="" data-scv-icon="">
customElements.define('scv-audio-transport', class extends HTMLElement { constructor() { super();
const _baked = !this.shadowRoot && this.querySelector('template[shadowrootmode], template.custom-shadow');
if (_baked) { this.attachShadow({mode: 'open'}).innerHTML = _baked.innerHTML; _baked.remove(); }
else if (!this.shadowRoot) this.attachShadow({mode: 'open'}).innerHTML = `<style>:host { display: block; --tr-pad: 10px; }
  .tr { width: 260px; background: var(--background-raised, #252727); border: 1px solid var(--border, #3A3C3C); border-radius: var(--corner-high, 8px); padding: var(--tr-pad); box-sizing: border-box; font-family: var(--font-mono, 'SF Mono', ui-monospace, monospace); user-select: none; -webkit-user-select: none; }
  .tr-title { text-align: center; font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-base, #AAABAC); }
  .tr-sig-readout { text-align: center; font-size: 26px; font-weight: 600; color: var(--output, #986C98); margin: 12px 0 8px; letter-spacing: 2px; line-height: 1; }
  .tr-sig-readout.dim { color: var(--text-dim, #888); opacity: .55; }
  .tr-row { display: flex; gap: 4px; }
  .tr-f { flex: 1; min-width: 0; }
  .tr-input { width: 100%; box-sizing: border-box; height: 28px; padding: 0 8px; border: none; border-radius: var(--corner-low, 5px); background: var(--background-sunk, #1A1C1C); color: var(--text-base, #AAABAC); font: 11px var(--font-mono, ui-monospace, monospace); text-align: center; outline: none; }
  .tr-input::placeholder { color: var(--text-dim, #888); opacity: .8; }
  .tr-input:focus { border-color: var(--input, #8AB6BB); }
  .tr-input::-webkit-outer-spin-button,
  .tr-input::-webkit-inner-spin-button,
  .tr-sigbox input::-webkit-outer-spin-button,
  .tr-sigbox input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .tr-input, .tr-sigbox input { -moz-appearance: textfield; appearance: textfield; }
  .tr-sigbox { flex: 1; min-width: 0; display: flex; align-items: stretch; height: 28px; border: none; border-radius: var(--corner-low, 5px); background: var(--background-sunk, #1A1C1C); overflow: hidden; }
  .tr-sigbox input { flex: 1; width: auto; min-width: 0; box-sizing: border-box; border: none; background: transparent; color: var(--text-base, #AAABAC); font: 11px var(--font-mono, ui-monospace, monospace); text-align: center; outline: none; padding: 0 4px; }
  .tr-sigbox input::placeholder { color: var(--text-dim, #888); opacity: .8; }
  .tr-sigbox .tr-sep { display: flex; align-items: center; color: var(--text-dim, #888); font-size: 12px; padding: 0 1px; }
  .tr-sigbox:focus-within { border-color: var(--input, #8AB6BB); }
  .tr-actions { display: flex; gap: 4px; margin-top: 4px; }
  .tr-btn { flex: 1; height: 26px; box-sizing: border-box; border: none; border-radius: var(--corner-low, 5px); background: var(--background-sunk, #1A1C1C); color: var(--text-base, #AAABAC); font: 9px var(--font-mono, ui-monospace, monospace); text-transform: uppercase; letter-spacing: 1px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 5px; }
  .tr-btn svg { fill: currentColor; display: block; pointer-events: none; width: 11px; height: 11px; }
  .tr-btn:hover { color: var(--input, #8AB6BB); }
  .tr-btn.on { background: var(--output, #986C98); color: var(--background-sunk, #1A1C1C); }
  .tr-btn.on:hover { color: var(--background-sunk, #1A1C1C); }
  .tr-port { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--border, #3A3C3C); }
  .tr-ins, .tr-outs { display: flex; flex-direction: column; gap: 4px; }
  .tr-p { display: flex; align-items: center; gap: 6px; font-size: 9px; letter-spacing: 1px; text-transform: lowercase; position: relative; }
  .tr-p::before { content: ''; width: 6px; height: 6px; border-radius: 50%; flex: none; }
  .tr-in { color: var(--input, #8AB6BB); } .tr-in::before { background: var(--input, #8AB6BB); }
  .tr-out { color: var(--output, #986C98); } .tr-out::before { background: var(--output, #986C98); }
  .ghost-port { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; border: none; padding: 0; margin: 0; background: transparent; font: inherit; color: inherit; outline: none; cursor: crosshair; }
  textarea[data-scv-slot] { display: none; }</style><div class="tr">
  <div class="tr-title">transport</div>
  <div class="tr-sig-readout dim" data-tr="sigread"><span data-tr="sigN">4</span> : <span data-tr="sigD">4</span></div>

  <div class="tr-row">
    <div class="tr-f">
      <input class="tr-input" type="number" data-tr="bpm" placeholder="bpm" min="20" max="300">
    </div>
    <div class="tr-sigbox">
      <input type="number" data-tr="num" placeholder="4" min="1" max="32">
      <span class="tr-sep">/</span>
      <input type="number" data-tr="den" placeholder="4" min="1" max="32">
    </div>
    <div class="tr-f">
      <input class="tr-input" type="number" data-tr="count" placeholder="count-in" min="1" max="4" step="1">
    </div>
  </div>

  <div class="tr-actions">
    <button type="button" class="tr-btn" data-tr="playbtn">
      <svg viewBox="0 0 24 24" data-tr="playico"><path d="M8 5v14l11-7z"></path></svg>
      <span>play</span>
    </button>
    <button type="button" class="tr-btn" data-tr="metbtn">met</button>
    <button type="button" class="tr-btn" data-tr="armbtn">arm</button>
  </div>

  <div class="tr-port">
    <div class="tr-ins">
      <div class="tr-p tr-in" title="receives: transport cmd {t,targetTime,rec} - t may be start/stop/rec/recOff/reset, or a bare bpm override">
        <span>in</span>
        <input type="text" readonly="" tabindex="-1" class="ghost-port" data-scv-receives="in">
      </div>
    </div>
    <div class="tr-outs">
      <div class="tr-p tr-out" data-scv-emits="out" data-scv-port="" title="emits: beat / bpm / cmd / transport, tagged by kind">out</div>
    </div>
  </div>

  <textarea data-scv-slot="state" hidden=""></textarea>
</div>`;
const root = this.shadowRoot, host = this, emit = v => this.dispatchEvent(new CustomEvent('scv-emit', { detail: v, bubbles: true, composed: true }));
let SCOPE_TOK = null;
  function scopeTok() {
    if (SCOPE_TOK) return SCOPE_TOK;
    const id = host && host.dataset ? (host.dataset.scvId || '') : '';
    const m = id.replace(/^(comp|imp|live)_/, '').replace(/[^a-z0-9]/gi, '');
    SCOPE_TOK = (m && m.length >= 4) ? m.slice(-6)
      : (host._scavScope || (host._scavScope = Math.random().toString(36).slice(2, 8)));
    return SCOPE_TOK;
  }
  const PRISTINE = /^[a-z][a-z-]*$/;
  function scopeAttr(el, attr) {
    const cur = el.getAttribute(attr); if (!cur) return;
    const next = cur.split(' ').map(tok => PRISTINE.test(tok) ? tok + '_' + scopeTok() : tok).join(' ');
    if (next !== cur) el.setAttribute(attr, next);
  }
  function applyScope() {
    root.querySelectorAll('[data-scv-receives], [data-scv-emits]').forEach(p => {
      scopeAttr(p, 'data-scv-receives');
      scopeAttr(p, 'data-scv-emits');
    });
  }

  // authored emit() dispatches from the host, so patchbay's drag-wire (which always snaps an authored
  // component's wire to its host) actually fires it - one real channel, tagged by kind, not one dot per signal
  const portEmit = (kind, v) => {
    const env = (v && typeof v === 'object' && !Array.isArray(v)) ? { kind, ...v } : { kind, value: v };
    emit(env);
  };

  const $ = s => root.querySelector(s);

  const setOn   = (el, c, on) => { if (el && el.classList.contains(c) !== !!on) el.classList.toggle(c, !!on); };
  const setTxt  = (el, v) => { if (el && el.textContent !== String(v)) el.textContent = v; };
  const setHtml = (el, h) => { if (el && el.innerHTML !== h) el.innerHTML = h; };
  const setVal  = (el, v) => { if (el && el.value !== String(v)) el.value = v; };

  const ICON_PLAY  = '<path d="M8 5v14l11-7z"/>';
  const ICON_STOP  = '<rect x="6" y="6" width="12" height="12"/>';

  let bpm = null, num = 4, den = 4, countLen = 1, arm = false, met = false;
  let running = false, beat = 0, bar = 0, tick = 0;
  let state = 'stop';                 // stop | counting | playing

  let timer = null, nextBeatTime = 0, barStartTime = 0, nextCmdStart = 0;
  let ac = null;
  const resumeAC = () => { if (ac && ac.state === 'suspended') ac.resume(); };
  window.addEventListener('pointerdown', resumeAC);
  window.addEventListener('keydown', resumeAC);

  const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));

  // shared AudioContext singleton
  function ensureAC() {
    if (ac && ac.state !== 'closed') return ac;
    if (!window.__SCAV_AC__) window.__SCAV_AC__ = new (window.AudioContext || window.webkitAudioContext)();
    ac = window.__SCAV_AC__;
    return ac;
  }
  function msPerBeat() {
    const b = Number(bpm) || 120;
    return (60000 / b) * (4 / (Number(den) || 4));
  }

  function syncUI() { // single paint path: visuals always re-derived from logic state
    applyScope();
    setHtml($('[data-tr="playico"]'), running ? ICON_STOP : ICON_PLAY);
    setOn($('[data-tr="playbtn"]'), 'on', running);
    setTxt($('[data-tr="playbtn"] span'), running ? 'stop' : 'play');
    setOn($('[data-tr="armbtn"]'), 'on', arm);
    setOn($('[data-tr="metbtn"]'), 'on', met);
    setTxt($('[data-tr="sigN"]'), num);
    setTxt($('[data-tr="sigD"]'), den);
    setOn($('[data-tr="sigread"]'), 'dim', state !== 'playing');
    const act = document.activeElement;
    const bpmIn = $('[data-tr="bpm"]'), numIn = $('[data-tr="num"]'), denIn = $('[data-tr="den"]'), cntIn = $('[data-tr="count"]');
    if (bpmIn && bpmIn !== act) setVal(bpmIn, bpm != null ? bpm : '');
    if (numIn && numIn !== act) setVal(numIn, num || 4);
    if (denIn && denIn !== act) setVal(denIn, den || 4);
    if (cntIn && cntIn !== act) setVal(cntIn, countLen || 1);
  }

  function emitBeat(b, playOn) {
    const env = { beat: b, bar: bar, bpm: Number(bpm) || 120, play: playOn ? 1 : 0, num: num, denom: den };
    portEmit('beat', env);
  }
  function emitBpm() { if (Number.isFinite(Number(bpm))) portEmit('bpm', Number(bpm)); }
  function emitCmd(t, targetTime, rec) {
    const env = { t: t, targetTime: targetTime };
    if (rec !== undefined) env.rec = rec;
    portEmit('cmd', env);
  }
  function emitTransport() {
    const spb = msPerBeat() / 1000;
    portEmit('transport', {
      run: state !== 'stop' ? 1 : 0,
      play: state === 'playing' ? 1 : 0,
      count: state === 'counting' ? 1 : 0,
      rec: arm ? 1 : 0,
      bar: bar, beat: beat, num: num, denom: den,
      bpm: Number(bpm) || 120,
      pos: tick,
      time: nextBeatTime,
      next: nextBeatTime + spb,
      spb: spb
    });
  }

  function clickAt(t) {
    if (!ac || !met) return;
    const osc = ac.createOscillator(), g = ac.createGain();
    osc.type = 'square';
    osc.frequency.value = 1480;
    g.gain.setValueAtTime(0, t);
    g.gain.linearRampToValueAtTime(0.3, t + 0.002);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 0.05);
    osc.connect(g).connect(ac.destination);
    osc.start(t);
    osc.stop(t + 0.06);
  }

  function schedule() {
    if (state === 'stop') return;
    const now = ac.currentTime;
    const spb = msPerBeat() / 1000;
    while (nextBeatTime <= now + 0.1) {
      const t = nextBeatTime;
      beat++; tick++;
      const isDown = beat % (num || 4) === 1;
      if (isDown) { barStartTime = t; bar++; }
      if (state === 'playing') {
        clickAt(t);
      } else if (state === 'counting') {
        clickAt(t);
        if (t + 1e-4 >= nextCmdStart) {
          state = 'playing';            // aligned downbeat reached: run starts now
          syncUI();
          emitBeat(beat, true);
          emitTransport();
          continue;
        }
      }
      emitBeat(beat, state === 'playing');
      emitTransport();
      nextBeatTime += spb;
    }
  }

  function start(externalTargetTime, recOverride) {
    if (running) return;            // guard vs re-entrant start-receive
    ensureAC();
    if (ac.state === 'suspended') ac.resume();
    if (!Number.isFinite(Number(bpm))) bpm = 120;
    if (!num) num = 4;
    if (!den) den = 4;
    if (!countLen) countLen = 1;
    running = true;
    beat = 0; bar = 0; tick = 0;
    const now = ac.currentTime;
    const spb = msPerBeat() / 1000;
    const barSec = (num || 4) * spb;
    nextBeatTime = now + 0.05;
    const recOn = recOverride !== undefined ? !!recOverride : arm;
    let t = Number(externalTargetTime);
    if (!Number.isFinite(t) || !(t > now + 0.02)) {
      t = nextBeatTime + Math.max(1, Math.ceil((now + 0.2 - nextBeatTime) / barSec)) * barSec;
      if (recOn) t += Math.max(0, (Number(countLen) || 1) - 1) * barSec;
    }
    nextCmdStart = t;
    state = recOn ? 'counting' : 'playing';
    syncUI();
    emitCmd('start', nextCmdStart, recOn ? 1 : 0);
    emitTransport();
    timer = setInterval(schedule, 25);
    emitBpm();
  }

  function punch(on) {              // punch in/out at the next downbeat while running
    if (!running) return;
    const now = ac.currentTime;
    const spb = msPerBeat() / 1000;
    const barSec = (num || 4) * spb;
    let t = (Number.isFinite(barStartTime) ? barStartTime : now) + barSec;
    while (t - now < 0.2) t += barSec;
    emitCmd(on ? 'rec' : 'recOff', t);
  }

  function stop() {
    running = false;
    if (timer) { clearInterval(timer); timer = null; }
    state = 'stop';
    syncUI();
    emitCmd('stop', ac ? ac.currentTime : 0);
    emitBeat(beat, false);
    emitTransport();
    persist();
  }

  function persist() {
    $('[data-scv-slot="state"]').value = [Number.isFinite(Number(bpm)) ? bpm : '', num, den, countLen, arm ? 1 : 0, met ? 1 : 0].join('|');
  }

  function render() {
    const parts = ($('[data-scv-slot="state"]').value || '').split('|');
    bpm    = parts[0] !== '' && parts[0] != null ? Number(parts[0]) : null;
    num    = Number(parts[1]) || 4;
    den    = Number(parts[2]) || 4;
    countLen = Number(parts[3]) || 1;
    arm    = parts[4] === '1';
    met    = parts[5] === '1';
    setVal($('[data-tr="bpm"]'),   bpm != null ? bpm : '');
    setVal($('[data-tr="num"]'),   num);
    setVal($('[data-tr="den"]'),   den);
    setVal($('[data-tr="count"]'), countLen);
    syncUI();
  }

  // events delegate to the shadow root, so they survive shadow swap + morph
  root.addEventListener('click', e => {
    const b = e.target && e.target.closest ? e.target.closest('[data-tr]') : null;
    if (!b) return;
    const t = b.dataset.tr;
    if (t === 'playbtn') { if (running) stop(); else start(); }
    else if (t === 'armbtn') { arm = !arm; syncUI(); persist(); if (running) punch(arm); }
    else if (t === 'metbtn') { met = !met; syncUI(); persist(); }
  });

  root.addEventListener('input', e => {
    const el = e.target, t = el.dataset && el.dataset.tr;
    if (t === 'bpm') { bpm = el.value === '' ? null : Number(el.value); emitBpm(); }
    else if (t === 'num') { num = Number(el.value) || null; }
    else if (t === 'den') { den = Number(el.value) || null; }
    else if (t === 'count') countLen = Math.round(clamp(Number(el.value) || 1, 1, 4));
    else return;
    syncUI();
    persist();
  });

  // one receive port for everything - a tagged {kind:'cmd',...} from another transport, or a bare number for a plain external bpm override
  root.addEventListener('scv-receive', e => {
    const p = e.target && e.target.closest ? e.target.closest('[data-scv-receives]') : null;
    if (!p) return;
    const chs = (p.getAttribute('data-scv-receives') || '').trim().split(/\s+/).filter(Boolean);
    const has = n => chs.some(t => t === n || t.indexOf(n + '_') === 0);
    const v = e.detail; // nothing in this system ever wraps a value - use the received payload as-is
    if (!has('in')) return;
    if (v && typeof v === 'object' && !Array.isArray(v) && typeof v.t === 'string') {
      const c = v;
      const now = ac ? ac.currentTime : 0;
      const tt = Number(c.targetTime);
      const tgt = Number.isFinite(tt) && tt > now + 0.02 ? tt : undefined;
      if (c.t === 'start') {
        if (running) { if (state === 'playing') return; stop(); }
        start(tgt, c.rec ? true : false);
      } else if (c.t === 'stop') { if (running) stop(); }
      else if (c.t === 'reset') { beat = 0; bar = 0; tick = 0; emitBeat(beat, state === 'playing'); emitTransport(); }
      else if (c.t === 'rec') { if (!arm) { arm = true; syncUI(); persist(); } punch(true); }
      else if (c.t === 'recOff') { if (arm) { arm = false; syncUI(); persist(); } punch(false); }
      return;
    }
    const raw = v && typeof v === 'object' && v.kind === 'bpm' ? v.value : v;
    const b = Number(raw);
    if (Number.isFinite(b)) {
      bpm = clamp(b, 20, 300);
      setVal($('[data-tr="bpm"]'), bpm);
      syncUI(); persist(); emitBpm(); emitBeat(beat, state === 'playing'); emitTransport();
    }
  });

  // redrop reconcile: re-scope + repaint visuals whenever patchbay morphs or swaps this shadow
  if (!window.__SCAV_SYNC__ && typeof MutationObserver === 'function') {
    window.__SCAV_SYNC__ = (root, syncFn) => {
      let t = null;
      new MutationObserver(() => {
        clearTimeout(t);
        t = setTimeout(() => { try { syncFn(); } catch (e) { console.error('scav sync', e); } }, 0);
      }).observe(root, { subtree: true, childList: true, attributes: true,
                        attributeFilter: ['data-scv-emits', 'data-scv-receives', 'class'] });
    };
  }
  __SCAV_SYNC__(root, syncUI);

  if (!window.__SCAV_LIFE__) {
    const lifeStop = new WeakMap(), lifeLive = new Set();
    let lifeOb = null;
    const lifeWalk = (n, add) => {
      if (n.nodeType !== 1) return false;
      let hit = false;
      if (lifeStop.has(n)) {
        hit = true;
        if (add) lifeLive.add(n);
        else if (lifeLive.has(n)) {
          lifeLive.delete(n);
          try { lifeStop.get(n)(); } catch (e) { console.error('scav teardown', e); }
        }
      }
      for (const c of n.children) if (lifeWalk(c, add)) hit = true;
      return hit;
    };
    window.__SCAV_LIFE__ = (host, stopFn) => {
      lifeStop.set(host, stopFn);
      if (host.isConnected) lifeLive.add(host);
      if (lifeOb) return;
      lifeOb = new MutationObserver(ms => {
        let d = false;
        for (const m of ms) {
          for (const n of m.addedNodes) d = lifeWalk(n, true) || d;
          for (const n of m.removedNodes) d = lifeWalk(n, false) || d;
        }
        if (d && !lifeLive.size) try { const a = window.__SCAV_AC__; if (a && a.state === 'running') a.suspend(); } catch {}
      });
      lifeOb.observe(document, { childList: true, subtree: true });
    };
  }
  __SCAV_LIFE__(host, () => {
    if (timer) { clearInterval(timer); timer = null; }
    running = false; beat = 0; bar = 0; tick = 0;
    state = 'stop';
    syncUI();
    window.removeEventListener('pointerdown', resumeAC);
    window.removeEventListener('keydown', resumeAC);
  });

  applyScope();
  render();
}
connectedCallback() { this.setAttribute('data-scv-emitter', ''); } });
</script>
</body></html>