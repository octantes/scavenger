<!DOCTYPE html>  <!-- scavenge.ar - © 2026 octantes.ar - SPDX-License-Identifier: Apache-2.0 -->
<html><head><meta charset="utf-8"><title>scv-percent - scav component</title><link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2016%2016%22%3E%3Ctext%20x%3D%228%22%20y%3D%2212%22%20font-size%3D%2211%22%20font-family%3D%22monospace%22%20fill%3D%22%23986c98%22%20text-anchor%3D%22middle%22%3E%26lt%3B%26gt%3B%3C%2Ftext%3E%3C%2Fsvg%3E"></head>
<body style="margin:0;background:#1a1c1c">
<scv-percent data-scv-component></scv-percent>
<script data-scv-comp data-scv-tag="scv-percent" data-scv-source="" data-scv-icon="">
customElements.define('scv-percent', class extends HTMLElement { constructor() { super();
const _baked = !this.shadowRoot && this.querySelector('template[shadowrootmode], template.custom-shadow');
if (_baked) { this.attachShadow({mode: 'open'}).innerHTML = _baked.innerHTML; _baked.remove(); }
else if (!this.shadowRoot) this.attachShadow({mode: 'open'}).innerHTML = `<style>:host { display: block; }
  .pr { width: 240px; background: var(--background-raised, #252727); border: 1px solid var(--border, #3A3C3C); border-radius: var(--corner-low, 5px); padding: 8px 10px; box-sizing: border-box; font-family: var(--font-mono, 'SF Mono', ui-monospace, monospace); }
  .pr-lab { color: var(--text-faint, #666666); font-size: 10px; text-transform: lowercase; letter-spacing: 1px; margin-bottom: 6px; }
  .pr-track { height: 10px; background: var(--background-sunk, #1A1C1C); border: 1px solid var(--border, #3A3C3C); border-radius: var(--corner-low, 5px); overflow: hidden; }
  .pr-fill { height: 100%; width: 0%; background: var(--input, #8AB6BB); border-radius: inherit; transition: width .12s ease; }
  .pr-read { display: flex; align-items: baseline; gap: 3px; margin-top: 6px; font-size: 12px; }
  .pr-read .v { color: var(--input, #8AB6BB); font-weight: 600; }
  .pr-read .m { color: var(--text-dim, #888888); }
  .pr-read .vt { font-size: 9px; color: var(--text-faint, #666666); text-transform: lowercase; letter-spacing: 1px; margin-left: auto; }</style><div class="pr">
  <div class="pr-lab" data-scv-slot="label">progress</div>
  <div class="pr-track"><div class="pr-fill"></div></div>
  <div class="pr-read">
    <span class="v" data-scv-slot="value">0</span><span class="m">/ 100</span>
    <span class="vt">%</span>
  </div>
</div>`;
const root = this.shadowRoot, host = this, emit = v => this.dispatchEvent(new CustomEvent('scv-emit', { detail: v, bubbles: true, composed: true }));
const fill = root.querySelector('.pr-fill'),
        val = root.querySelector('[data-scv-slot="value"]');
  const clampPct = s => { const n = parseFloat(String(s)); return Number.isFinite(n) ? Math.min(100, Math.max(0, n)) : 0; };
  const sync = () => { fill.style.width = clampPct(val.textContent) + '%'; };
  host.addEventListener('scv-receive', e => { val.textContent = e.detail; sync(); });
  new MutationObserver(sync).observe(val, { characterData: true, childList: true });
  sync();
}
connectedCallback() { this.setAttribute('data-scv-emitter', ''); } });
</script>
</body></html>