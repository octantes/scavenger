      stopSrc();
      srcNode = ac.createBufferSource();
      srcNode.buffer = aBuf;
      srcNode.connect(outGain);
      srcNode.onended = () => { if (current === i) { playing = false; stopMeter(); setRowIcons(); } srcNode = null; };
      const when = Number(atTime);
      if (Number.isFinite(when) && when > ac.currentTime + 0.001) {
        srcNode.start(when, offsetSeconds || 0);
      } else {
        srcNode.start(0, offsetSeconds || 0);
      }
      pendingStartAwait = false;
      outGain.gain.value = vol;
      emitLive(aBuf);
      emitURL();
      emitID();
    }).catch(err => { console.error('decode/playback failed', t.url.slice(0, 60), err); playing = false; pendingStartAwait = false; setRowIcons(); stopMeter(); });
  }

  function playTake(i) {
    if (i < 0 || i >= takes.length) return;
    ensureAC();
    if (i === current && playing) { pauseTake(); return; }
    if (playing) stopSrc();
    if (recording) { stopRec(); }
    current = i; playing = true;
    pendingStartAwait = false;
    setRowIcons(); startMeter();
    resume().then(() => { if (current !== i) return; startTakeBuffer(i, 0); });
  }
  function pauseTake() { playing = false; stopSrc(); current = -1; setRowIcons(); stopMeter(); }

  function removeTake(i) {
    if (current === i) { playing = false; current = -1; stopSrc(); stopMeter(); }
    else if (i < current) current--;
    takes.splice(i, 1);
    rebuildRows(); setRowIcons(); persistTakes();
  }

  function markRow(i, on) {
    const rows = $('.at-rows'); if (!rows) return;
    const row = rows.querySelectorAll('.at-row')[i];
    if (row) row.classList.toggle('recv', !!on);
  }
  function armOff() { root.querySelectorAll('.at-row').forEach(r => r.classList.remove('recv')); }
  function armOnTap() {
    arm = !arm;
    setOn($('[data-at="arm"]'), 'on', arm);
    if (!arm) armOff();
    else if (recording && current >= 0) markRow(current, true);
    persistMixer();
  }

  const pickMime = () =>
    MediaRecorder.isTypeSupported('audio/webm;codecs=opus') ? 'audio/webm;codecs=opus'
    : MediaRecorder.isTypeSupported('audio/webm') ? 'audio/webm'
    : MediaRecorder.isTypeSupported('audio/mp4') ? 'audio/mp4'
    : '';

  function beginCapture(takeName) {
    ensureAC();
    navigator.mediaDevices.getUserMedia({ audio: true }).then(s => {
      if (recCancel) { s.getTracks().forEach(x => x.stop()); return; }
      stream = s;
      const mime = pickMime();
      try {
        mediaRec = mime ? new MediaRecorder(s, { mimeType: mime, audioBitsPerSecond: 320000 }) : new MediaRecorder(s, { audioBitsPerSecond: 320000 });
      } catch (e) {
        mediaRec = mime ? new MediaRecorder(s, { mimeType: mime }) : new MediaRecorder(s);
      }
      const chunks = [];
      mediaRec.ondataavailable = e => { if (e.data.size) chunks.push(e.data); };
      mediaRec.onstop = () => {
        const blob = new Blob(chunks, { type: mediaRec.mimeType || mime || 'audio/webm' });
        toDataURL(blob).then(url => {
          if (recTake != null) { takes[recTake].url = url; takes[recTake].played = null; takes[recTake].id || (takes[recTake].id = genId()); }
          else { takes.push({ name: takeName, url, id: genId() }); recTake = takes.length - 1; }
          rebuildRows(); persistTakes(); hydrate(); markRow(recTake, true);
        }).catch(err => console.error('save take failed', err));
