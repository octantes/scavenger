      return;
    }
    const frEl = e.target && e.target.closest ? e.target.closest('[data-sp="frame"]') : null;
    if (!frEl || !clip) return;
    const fr = F(); const rect = fr.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const hit = sliceHit(x);
    if (hit >= 0) {
      if (!slices.length) slices = autoSlices.slice();
      const si = reachToStored(hit);
      if (si >= 0) slices.splice(si, 1);
    } else {
      const f = clamp(viewStart + (x / fr.clientWidth) * viewSpan, clipStart, clipEnd);
      if (!slices.length && autoSlices.length) slices = autoSlices.slice();
      slices.push(f); slices.sort((a, b) => a - b);
    }
    redraw(); persist();
  });
  root.addEventListener('click', e => {
    if (e.target && e.target.closest && e.target.closest('[data-sp="empty"]')) { ensureAC(); resume(); const fi = $('[data-sp="file"]'); if (fi) fi.click(); return; }
    const modeEl = e.target && e.target.closest ? e.target.closest('[data-sp^="mode-"]') : null;
    if (modeEl) { mode = modeEl.dataset.sp.slice(5); killAll(); slices = []; syncUI(); redraw(); persist(); return; }
    const warpEl = e.target && e.target.closest ? e.target.closest('[data-sp^="warp-"]') : null;
    if (warpEl) { warp = warpEl.dataset.sp.slice(5); syncUI(); persist(); return; }
    const kbEl = e.target && e.target.closest ? e.target.closest('[data-sp="kbtn"]') : null;
    if (kbEl) { kbOn = !kbOn; if (!kbOn) noteOffAll(); syncUI(); persist(); }
  });
  root.addEventListener('input', e => {
    const t = e.target && e.target.dataset ? e.target.dataset.sp : null;
    if (t === 'bpm') { const b = Number(e.target.value); if (b) { bpm = clamp(b, 20, 300); redraw(); persist(); } }
    else if (t === 'root') { rootNote = clamp(Math.round(Number(e.target.value) || 60), 0, 127); persist(); }
  });
  root.addEventListener('change', e => {
    const fi = e.target && e.target.dataset && e.target.dataset.sp === 'file' ? e.target : null;
    if (!fi) return;
    const f = fi.files[0];
    if (f && f.type.startsWith('audio/')) { ensureAC(); toDataURL(f).then(loadUrl); }
    fi.value = '';
  });

  // one receive port for everything - dispatch by kind for our own family signals (take/cmd/transport/bpm),
  // fall back structurally for a foreign source (a bare note object, or a bare bpm number)
  root.addEventListener('scv-receive', e => {
    const p = e.target && e.target.closest ? e.target.closest('[data-scv-receives]') : null;
    if (!p) return;
    const chs = (p.getAttribute('data-scv-receives') || '').trim().split(/[\s,]+/).filter(Boolean);
    const has = n => chs.some(t => t === n || t.indexOf(n + '_') === 0);
    const v = e.detail; // nothing in this system ever wraps a value - use the received payload as-is
    if (!has('in')) return;
    if (v && v.kind === 'take-url') {
      if (alive() && typeof v.value === 'string' && v.value.startsWith('data:')) { ensureAC(); loadUrl(v.value); }
      return;
    }
    if (v && v.kind === 'take-id') {
      if (alive() && typeof v.value === 'string') { curKey = v.value; loadSetup(); }
      return;
    }
    if (v && v.kind === 'bpm') {
      if (!alive()) return;
      const b = Number(v.value); if (Number.isFinite(b)) { bpm = clamp(b, 20, 300); const bi = $('[data-sp="bpm"]'); if (bi && bi !== document.activeElement) setVal(bi, bpm); redraw(); }
      return;
    }
    if (v && v.kind === 'cmd') {
      if (!alive()) return;
      const c = v;
      if (typeof c.t !== 'string') return;
      if (c.t === 'stop' || c.t === 'reset') {
        if (beatTimer) { clearTimeout(beatTimer); beatTimer = null; beatToken++; }
        beatQ = [];
        killAll();
      } else if (c.t === 'start') {
        ensureAC(); resume();
      }
      return;
    }
    if (v && v.kind === 'transport') {
      if (!alive()) return;
      const env = v;
      if (typeof env.run === 'undefined') return;
      transportEnv = env;
      if (env.run) {
        ensureAC();
        if (beatQ.length) scheduleBeatFlush();
      } else {
        if (beatTimer) { clearTimeout(beatTimer); beatTimer = null; beatToken++; }
        fireQueued();
      }
      return;
    }
    if (!alive()) return;
    if (v && typeof v === 'object' && !Array.isArray(v) && 'on' in v) {
      const nn = v;
      if (nn.on === 1 || nn.on === true) {
        ensureAC();
        const quant = !!transportEnv && !!transportEnv.run && Number.isFinite(Number(transportEnv.next));
        if (quant) beatQ.push({ note: nn.note ?? 60, velocity: nn.velocity ?? 100 });
        resume().then(() => { if (quant) scheduleBeatFlush(); else noteOn(nn.note ?? 60, nn.velocity ?? 100); });
      }
      else if (nn.on === 0 || nn.on === false) noteOffAll();
      return;
    }
    const b = Number(v);
    if (Number.isFinite(b)) { bpm = clamp(b, 20, 300); const bi = $('[data-sp="bpm"]'); if (bi && bi !== document.activeElement) setVal(bi, bpm); redraw(); }
  });

  // ---- redrop / swap reconcile ----
  if (!window.__SCAV_SYNC__ && typeof MutationObserver === 'function') {
    window.__SCAV_SYNC__ = (root, syncFn) => {
      let t = null;
      new MutationObserver(() => {
        clearTimeout(t);
        t = setTimeout(() => { try { syncFn(); } catch (e) { console.error('scav sync', e); } }, 0);
      }).observe(root, { subtree: true, childList: true, attributes: true, attributeFilter: ['data-scv-emits', 'data-scv-receives', 'class'] });
    };
  }
  __SCAV_SYNC__(root, syncUI);

  // ---- lifecycle teardown ----
  if (!window.__SCAV_LIFE__) {
    const lifeStop = new WeakMap(), lifeLive = new Set();
    let lifeOb = null;
    const lifeWalk = (n, add) => {
      if (n.nodeType !== 1) return false;
      let hit = false;
      if (lifeStop.has(n)) {
        hit = true;
        if (add) lifeLive.add(n);
        else if (lifeLive.has(n)) {
          lifeLive.delete(n);
          try { lifeStop.get(n)(); } catch (e) { console.error('scav teardown', e); }
        }
      }
      for (const c of n.children) if (lifeWalk(c, add)) hit = true;
      return hit;
    };
    window.__SCAV_LIFE__ = (host, stopFn) => {
      lifeStop.set(host, stopFn);
      if (host.isConnected) lifeLive.add(host);
      if (lifeOb) return;
      lifeOb = new MutationObserver(ms => {
        let d = false;
        for (const m of ms) {
          for (const n of m.addedNodes) d = lifeWalk(n, true) || d;
          for (const n of m.removedNodes) d = lifeWalk(n, false) || d;
        }
        if (d && !lifeLive.size) try { const a = window.__SCAV_AC__; if (a && a.state === 'running') a.suspend(); } catch {}
      });
      lifeOb.observe(document, { childList: true, subtree: true });
    };
  }
  __SCAV_LIFE__(host, () => {
    window.removeEventListener('keydown', onKbd);
    window.removeEventListener('keyup', offKbd);
    for (const k in held) delete held[k];
    if (beatTimer) { clearTimeout(beatTimer); beatTimer = null; }
    beatQ = [];
    killAll();
    kbOn = false;
    syncUI();
  });

  function boot() {
    const slotEl = $('[data-scv-slot="state"]'); if (!slotEl) return;
    const parts = (slotEl.value || '').split('\n--\n');
    if (parts.length > 1) { const st = parts[1].split('|'); curKey = st[0] || null; bpm = Number(st[1]) || 120; rootNote = clamp(Number(st[2]) || 60, 0, 127); }
    syncUI();
    const tick = () => { const fr = F(); if (fr && fr.isConnected) { applyVisibility(); if (clip) redraw(); requestAnimationFrame(tick); } };
    requestAnimationFrame(tick);
  }
  boot();
  requestAnimationFrame(boot);
  setTimeout(boot, 0);
}
connectedCallback() { this.setAttribute('data-scv-emitter', ''); } });
</script>
</body></html>