<!DOCTYPE html>  <!-- scavenge.ar - © 2026 octantes.ar - SPDX-License-Identifier: Apache-2.0 -->
<html><head><meta charset="utf-8"><title>scv-chart-line - scav component</title><link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2016%2016%22%3E%3Ctext%20x%3D%228%22%20y%3D%2212%22%20font-size%3D%2211%22%20font-family%3D%22monospace%22%20fill%3D%22%23986c98%22%20text-anchor%3D%22middle%22%3E%26lt%3B%26gt%3B%3C%2Ftext%3E%3C%2Fsvg%3E"></head>
<body style="margin:0;background:#1a1c1c">
<scv-chart-line data-scv-component></scv-chart-line>
<script data-scv-comp data-scv-tag="scv-chart-line" data-scv-source="" data-scv-icon="">
customElements.define('scv-chart-line', class extends HTMLElement { constructor() { super();
const _baked = !this.shadowRoot && this.querySelector('template[shadowrootmode], template.custom-shadow');
if (_baked) { this.attachShadow({mode: 'open'}).innerHTML = _baked.innerHTML; _baked.remove(); }
else if (!this.shadowRoot) this.attachShadow({mode: 'open'}).innerHTML = `<style>:host { display: block; }
  .sp { background: var(--background-sunk, #1A1C1C); border: 1px solid var(--border, #3A3C3C); border-radius: var(--corner-high, 8px); padding: 12px 14px 10px; font: 11px var(--font-mono, 'SF Mono', monospace); color: var(--text-dim, #888888); width: 280px; box-sizing: border-box; }
  .sp-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px; }
  .sp-lab { color: var(--text-faint, #666666); font-size: 10px; text-transform: lowercase; letter-spacing: 1px; }
  .sp-last { font-size: 16px; color: var(--input, #8AB6BB); }
  svg { display: block; width: 100%; height: 90px; }
  .s-line { stroke: var(--input, #8AB6BB); stroke-width: 1.5; fill: none; }
  .s-area { fill: var(--input, #8AB6BB); fill-opacity: .15; }</style><div class="sp">
  <div class="sp-head"><span class="sp-lab" data-scv-slot="label">sparkline</span><span class="sp-last" data-scv-slot="last">—</span></div>
  <svg viewBox="0 0 280 90" preserveAspectRatio="none"></svg>
</div>`;
const root = this.shadowRoot, host = this, emit = v => this.dispatchEvent(new CustomEvent('scv-emit', { detail: v, bubbles: true, composed: true }));
const svg = root.querySelector('svg'), last = root.querySelector('[data-scv-slot="last"]');
  const NS = 'http://www.w3.org/2000/svg', W = 280, H = 90, MAX = 60;
  let series = [];
  function draw() {
    while (svg.firstChild) svg.removeChild(svg.firstChild);
    const n = series.length;
    if (n < 2) return;
    let lo = Math.min(...series), hi = Math.max(...series);
    if (hi === lo) { hi += 1; lo -= 1; }
    const pad = (hi - lo) * 0.12; lo -= pad; hi += pad;
    const y = v => H - ((v - lo) / (hi - lo)) * H;
    const x = i => n > 1 ? (i / (n - 1)) * W : W / 2;
    const pts = series.map((v, i) => [x(i), y(v)]);
    // area fill (close down to bottom of chart then back)
    const areaPath = 'M' + pts.map(p => p[0].toFixed(1) + ' ' + p[1].toFixed(1)).join(' L')
      + ' L' + x(n - 1).toFixed(1) + ' ' + H + ' L' + x(0).toFixed(1) + ' ' + H + ' Z';
    const area = document.createElementNS(NS, 'path');
    area.setAttribute('d', areaPath); area.setAttribute('class', 's-area'); svg.appendChild(area);
    // stroke line
    const line = document.createElementNS(NS, 'polyline');
    line.setAttribute('points', pts.map(p => p[0].toFixed(1) + ',' + p[1].toFixed(1)).join(' '));
    line.setAttribute('class', 's-line'); svg.appendChild(line);
  }
  host.addEventListener('scv-receive', e => {
    const p = parseFloat(String(e.detail).replace(/[^0-9.eE+-]/g, '')); if (isNaN(p)) return;
    last.textContent = p;
    series.push(p); if (series.length > MAX) series.shift();
    draw();
  });
  draw();
}
connectedCallback() { this.setAttribute('data-scv-emitter', ''); } });
</script>
</body></html>