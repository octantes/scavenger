  let dMode = null, dX = 0, dY = 0, dVSpan = 0, dAnchor = 0, dRatio = 0, dF = 0;
  const F = () => $('[data-sp="frame"]');
  const XT = f => { const fr = F(); return fr ? ((f - viewStart) / viewSpan) * fr.clientWidth : 0; };
  function zoomAt(cx, factor) {
    const fr = F(); if (!fr) return;
    const cw = fr.clientWidth, ratio = cx / cw, anchor = viewStart + ratio * viewSpan;
    const ns = Math.max(0.005, Math.min(1, viewSpan * factor));
    viewSpan = ns; viewStart = ns >= 1 ? 0 : Math.max(0, Math.min(1 - ns, anchor - ratio * ns)); redraw();
  }
  function panBy(dx) {
    const fr = F(); if (!fr) return;
    const ns = viewSpan, cw = fr.clientWidth;
    viewStart = ns >= 1 ? 0 : Math.max(0, Math.min(1 - ns, viewStart - (dx / cw) * ns)); redraw();
  }
  function sliceHit(x) {
    const rel = mode === 'slice' ? currentSlices() : [];
    for (let i = 0; i < rel.length; i++) {
      const f = clipStart + rel[i] * (clipEnd - clipStart);
      if (Math.abs(x - XT(f)) < 6) return i;
    }
    return -1;
  }
  function frameDown(e) {
