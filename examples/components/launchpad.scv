<!DOCTYPE html>  <!-- scavenge.ar - © 2026 octantes.ar - SPDX-License-Identifier: Apache-2.0 -->
<html><head><meta charset="utf-8"><title>scv-launchpad - scav component</title><link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2016%2016%22%3E%3Ctext%20x%3D%228%22%20y%3D%2212%22%20font-size%3D%2211%22%20font-family%3D%22monospace%22%20fill%3D%22%23986c98%22%20text-anchor%3D%22middle%22%3E%26lt%3B%26gt%3B%3C%2Ftext%3E%3C%2Fsvg%3E"></head>
<body style="margin:0;background:#1a1c1c">
<scv-launchpad data-scv-component></scv-launchpad>
<script data-scv-comp data-scv-tag="scv-launchpad" data-scv-source="" data-scv-icon="">
customElements.define('scv-launchpad', class extends HTMLElement { constructor() { super();
const _baked = !this.shadowRoot && this.querySelector('template[shadowrootmode], template.custom-shadow');
if (_baked) { this.attachShadow({mode: 'open'}).innerHTML = _baked.innerHTML; _baked.remove(); }
else if (!this.shadowRoot) this.attachShadow({mode: 'open'}).innerHTML = `<style>:host { display: block; }
  .pg { width: 240px; background: var(--background-raised, #252727); border: 1px solid var(--border, #3A3C3C); border-radius: var(--corner-low, 5px); padding: 8px 10px; box-sizing: border-box; font-family: var(--font-mono, 'SF Mono', ui-monospace, monospace); }
  .pg-lab { color: var(--text-faint, #666666); font-size: 10px; text-transform: lowercase; letter-spacing: 1px; margin-bottom: 6px; }
  .pg-cfg { display: flex; align-items: center; gap: 4px; margin-bottom: 4px; }
  .pg-cfg label { display: flex; flex: 1; align-items: center; gap: 4px; font-size: 9px; color: var(--text-dim, #888888); text-transform: lowercase; letter-spacing: 1px; }
  .pg-cfg input[type=number] { width: 100%; background: var(--background-sunk, #1A1C1C); border: none; border-radius: var(--corner-low, 5px); color: var(--text-base, #AAABAC); font: 11px var(--font-mono, 'SF Mono', monospace); padding: 3px 4px; outline: none; -moz-appearance: textfield; appearance: textfield; }
  .pg-cfg input[type=number]::-webkit-inner-spin-button,
  .pg-cfg input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .pg-cfg input[type=number]:focus { border-color: var(--input, #8AB6BB); }
  .pg-grid { display: grid; gap: 4px; grid-auto-rows: 34px; }
  .pg-grid .pad { width: 100%; height: 100%; border: none; border-radius: var(--corner-low, 5px); background: var(--background-sunk, #1A1C1C); cursor: pointer; touch-action: none; transition: background .1s, transform .05s; }
  .pg-grid .pad:hover { background: var(--hl-ctx, var(--output, #986C98)); }
  .pg-grid .pad:active { transform: scale(.94); }
  .pg-grid .pad.hit { background: var(--input, #8AB6BB); }</style><div class="pg">
  <div class="pg-lab" data-scv-slot="label">pad grid</div>
  <div class="pg-cfg">
    <label><input type="number" min="1" max="16" placeholder="cols" data-scv-slot="cols"></label>
    <label><input type="number" min="1" max="16" placeholder="rows" data-scv-slot="rows"></label>
  </div>
  <div class="pg-grid"></div>
</div>`;
const root = this.shadowRoot, host = this, emit = v => this.dispatchEvent(new CustomEvent('scv-emit', { detail: v, bubbles: true, composed: true }));
const colsIn = root.querySelector('[data-scv-slot="cols"]'),
        rowsIn = root.querySelector('[data-scv-slot="rows"]'),
        grid = root.querySelector('.pg-grid');
  const pads = new Map(); // index -> pad node; re-appended (same node) if a morph detaches it, so data-scv-emits + wiring survive
  const clamp = n => Math.max(1, Math.min(16, Math.floor(+n) || 1));
  function makePad() {
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'pad';
    b.dataset.scvEmits = ''; // each pad its own wire channel
    b.addEventListener('click', () => {
      b.classList.add('hit'); setTimeout(() => b.classList.remove('hit'), 140);
      b.dispatchEvent(new CustomEvent('scv-emit', { detail: 1, bubbles: true, composed: true }));
    });
    return b;
  }
  let syncing = false;
  function sync() {
    if (syncing) return; syncing = true;
    try {
      const cols = clamp(colsIn.value), rows = clamp(rowsIn.value), total = cols * rows;
      grid.style.gridTemplateColumns = `repeat(${cols}, 1fr)`;
      for (let i = 0; i < total; i++) {
        let b = pads.get(i);
        if (!b) { b = makePad(); pads.set(i, b); }
        if (!b.isConnected) grid.appendChild(b); // re-insert SAME node stripped by a preview morph (keeps its channel + cable)
        b.hidden = false;
      }
      for (let i = total; i < pads.size; i++) { const b = pads.get(i); if (b.isConnected) b.hidden = true; } // shrink hides, never destroys
    } finally { syncing = false; }
  }
  new MutationObserver(sync).observe(grid, { childList: true }); // rebuild after CSS-only edits/re-drop strip pads
  colsIn.addEventListener('input', sync);
  rowsIn.addEventListener('input', sync);
  sync();
  requestAnimationFrame(sync);
  setTimeout(sync, 0);
}
connectedCallback() { this.setAttribute('data-scv-emitter', ''); } });
</script>
</body></html>