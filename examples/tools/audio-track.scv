    setHtml($('[data-at="add"]'), ICON.plus);
    setOn($('[data-at="add"]'), 'rec', false);
  }

  function startRec() { recTake = null; beginCapture('rec ' + (++recN)); }
  function stopRec() { endCapture(); }

  function scheduleCapture(atTime) {
    if (recording) return;
    recCancel = false;
    if (recTimer) { clearTimeout(recTimer); recTimer = null; }
    ensureAC();
    const now = ac.currentTime;
    let when = Number(atTime);
    if (!Number.isFinite(when) || when <= now) when = now + 0.05;
    const delay = Math.max(0, (when - now - 0.02) * 1000);
    recTimer = setTimeout(() => {
