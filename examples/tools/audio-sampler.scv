else if (!this.shadowRoot) this.attachShadow({mode: 'open'}).innerHTML = `<style>:host { display: block; }
  .sp { width: 980px; box-sizing: border-box; background: var(--background-raised, #252727); border: 1px solid var(--border, #3A3C3C); border-radius: var(--corner-high, 8px); padding: 8px 10px 10px; font-family: var(--font-mono, 'SF Mono', ui-monospace, monospace); user-select: none; -webkit-user-select: none; color: var(--text-base, #AAABAC); }
  .sp-title { text-align: center; font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-base, #AAABAC); margin-bottom: 6px; }
  .sp-main { display: flex; gap: 8px; }
  .sp-modes { display: flex; flex-direction: column; gap: 8px; width: 86px; flex: none; }
  .sp-modes .sp-btn { width: 100%; flex: 1; }
  .sp-frame { position: relative; flex: 1; height: 210px; background: var(--background-sunk, #1A1C1C); border-radius: var(--corner-low, 5px); overflow: hidden; touch-action: none; cursor: crosshair; }
  .sp-frame canvas { display: block; width: 100%; height: 100%; border: 0; padding: 0; margin: 0; }
  .sp-empty { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 6px; font-size: 12px; color: var(--text-dim, #888); letter-spacing: 1px; cursor: pointer; background: var(--background-sunk, #1A1C1C); }
  .sp-empty[hidden] { display: none; }
  .sp-empty::before { content: '+'; font-size: 26px; line-height: 1; color: var(--input, #8AB6BB); }

  .sp-port { display: flex; gap: 18px; margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--border, #3A3C3C); align-items: stretch; }
  .sp-col { display: flex; flex-direction: column; justify-content: space-between; gap: 4px; }
  .sp-col-outs { align-items: flex-end; }
  .sp-p { position: relative; display: flex; align-items: center; gap: 6px; font-size: 9px; letter-spacing: 1px; text-transform: lowercase; white-space: nowrap; }
  .sp-p::before { content: ''; width: 6px; height: 6px; border-radius: 50%; flex: none; }
  .sp-in { color: var(--input, #8AB6BB); } .sp-in::before { background: var(--input, #8AB6BB); }
  .sp-out { color: var(--output, #986C98); } .sp-out::before { background: var(--output, #986C98); }
  .ghost-port { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; border: none; padding: 0; margin: 0; background: transparent; font: inherit; color: inherit; outline: none; cursor: crosshair; }

  .sp-ctl { flex: 1; display: flex; gap: 20px; align-items: center; justify-content: center; }
  .sp-left { display: flex; gap: 8px; align-items: center; }
  .sp-leftcol { display: flex; flex-direction: column; justify-content: center; gap: 8px; }
  .sp-num { width: 60px; height: 24px; box-sizing: border-box; border: none; border-radius: var(--corner-low, 5px); background: var(--background-sunk, #1A1C1C); color: var(--text-base, #AAABAC); font: 11px var(--font-mono, ui-monospace, monospace); text-align: center; outline: none; padding: 0 4px; }
  .sp-num::-webkit-outer-spin-button, .sp-num::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .sp-num { -moz-appearance: textfield; appearance: textfield; }
  .sp-num::placeholder { color: var(--text-dim, #888); opacity: .8; }
  .sp-kbtxt { width: 60px; height: 24px; display: flex; align-items: center; justify-content: center; font-size: 9px; letter-spacing: 1px; text-transform: uppercase; box-sizing: border-box; cursor: pointer; border-radius: var(--corner-low, 5px); background: var(--background-sunk, #1A1C1C); color: var(--text-base, #AAABAC); }
  .sp-kbtxt:hover { color: var(--input, #8AB6BB); }
