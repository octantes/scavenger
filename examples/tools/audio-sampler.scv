  // ---- keyboard-as-midi: orphaned instances may release but never start audio ----
  const KEYMAP = { a: 0, w: 1, s: 2, e: 3, d: 4, f: 5, t: 6, g: 7, y: 8, h: 9, u: 10, j: 11, k: 12, o: 13, l: 14 };
  function kbOctave() { return (kbOct + 1) * 12; }
  const onKbd = e => {
    if (!alive() || !kbOn) return;
    if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT' || e.target.tagName === 'TEXTAREA')) return;
    const k = e.key.toLowerCase();
    if (k === 'z') { kbOct = Math.max(0, kbOct - 1); syncUI(); e.preventDefault(); return; }
    if (k === 'x') { kbOct = Math.min(6, kbOct + 1); syncUI(); e.preventDefault(); return; }
    if (!(k in KEYMAP) || held[k]) return;
    held[k] = true;
    const note = kbOctave() + KEYMAP[k];
    if (clip) { ensureAC(); resume().then(() => noteOn(note, 100)); }
  };
  const offKbd = e => {
    const k = e.key.toLowerCase(); if (held[k]) { held[k] = false; noteOffAll(); }
  };
  window.addEventListener('keydown', onKbd);
  window.addEventListener('keyup', offKbd);

  // ---- single guarded paint path ----
  function syncUI() {
    applyScope();
    for (const k of ['classic', 'oneshot', 'slice']) setOn($('[data-sp="mode-' + k + '"]'), 'on', mode === k);
    for (const w of ['re-pitch', 'beats']) setOn($('[data-sp="warp-' + w + '"]'), 'on', warp === w);
    setOn($('[data-sp="kbtn"]'), 'on', kbOn);
    setTxt($('[data-sp="oct"]'), 'oct ' + (kbOct + 1));
    const bpmIn = $('[data-sp="bpm"]'), rootIn = $('[data-sp="root"]');
    if (bpmIn && bpmIn !== document.activeElement) setVal(bpmIn, bpm);
    if (rootIn && rootIn !== document.activeElement) setVal(rootIn, rootNote);
    applyVisibility();
    for (const k of KNOBS) knobPaint(k[0], k[1], k[3], k[4], k[5], k[6]);
  }

  // ---- persistence (setup ONLY - binary stays in the track via take-url/-id) ----
  function persist() {
    const slotEl = $('[data-scv-slot="state"]'); if (!slotEl) return;
    const key = curKey || (clip ? 'self' : null);
    const head = (slotEl.value.split('\n--\n')[0] || '').split('\n').filter(l => l && (key ? !l.startsWith(key + '\t') : true));
    if (key) head.push([key, clipStart, clipEnd, mode, warp, gain, attack, decay, sustain, release, bpm, rootNote, slices.join(','), kbOn ? 1 : 0, kbOct, fadeIn, fadeOut, sensVal, voices, semi].join('\t'));
    slotEl.value = head.join('\n') + '\n--\n' + [(curKey || ''), bpm, rootNote].join('|');
  }
  function loadSetup() {
    if (!alive()) return;
    const slotEl = $('[data-scv-slot="state"]'); if (!slotEl) return;
    const head = (slotEl.value || '').split('\n--\n')[0] || '';
    for (const ln of head.split('\n')) {
      if (!ln.startsWith(curKey + '\t')) continue;
      const p = ln.split('\t');
      if (p.length >= 12) {
        clipStart = clamp(Number(p[1]) || 0, 0, 1); clipEnd = clamp(Number(p[2]) || 1, 0, 1); if (clipEnd <= clipStart) clipEnd = Math.min(1, clipStart + 0.001);
        mode = p[3] || 'classic'; warp = p[4] || 're-pitch'; gain = Number(p[5]) || 1; attack = Number(p[6]) || 0.005; decay = Number(p[7]) || 0.1; sustain = Number(p[8]) || 0.8; release = Number(p[9]) || 0.2; bpm = Number(p[10]) || 120; rootNote = Number(p[11]) || 60;
        slices = p[12] ? p[12].split(',').map(Number).filter(x => Number.isFinite(x) && x > 0 && x < 1) : [];
        kbOn = p[13] === '1'; kbOct = Math.min(6, Math.max(0, Number(p[14]) || 4));
        fadeIn = Number(p[15]) || 0.01; fadeOut = Number(p[16]) || 0.01; sensVal = clamp(Number(p[17]) || 50, 0, 100);
        voices = clamp(Number(p[18]) || 4, 1, 64);
        semi = clamp(Number(p[19]) || 0, -12, 12);
      }
      break;
    }
    detectTransients(); syncUI(); redraw();
  }

  // ---- delegated events ----
  root.addEventListener('pointerdown', e => {
    const dl = e.target && e.target.closest ? e.target.closest('[data-sp-dial]') : null;
    if (dl) { startKnobDrag(dl.dataset.spDial, dl, e); return; }
    const frEl = e.target && e.target.closest ? e.target.closest('[data-sp="frame"]') : null;
    if (frEl) frameDown(e);
  });
  root.addEventListener('pointermove', frameMove);
  root.addEventListener('pointerup', frameUp);
  root.addEventListener('pointercancel', frameUp);
  root.addEventListener('auxclick', e => { if (e.button === 1) e.preventDefault(); });
  root.addEventListener('wheel', e => {
    const frEl = e.target && e.target.closest ? e.target.closest('[data-sp="frame"]') : null;
    if (!frEl || !clip) return;
    e.preventDefault();
    const fr = F(); const rect = fr.getBoundingClientRect();
    const cx = Math.max(0, Math.min(fr.clientWidth, e.clientX - rect.left));
    zoomAt(cx, e.deltaY < 0 ? 0.85 : 1.18);
  }, { passive: false });
  root.addEventListener('dblclick', e => {
    const dl = e.target && e.target.closest ? e.target.closest('[data-sp-dial]') : null;
    if (dl) {
      const k = KNOBS.find(kx => kx[0] === dl.dataset.spDial);
