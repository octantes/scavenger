<!DOCTYPE html>  <!-- scavenge.ar - © 2026 octantes.ar - SPDX-License-Identifier: Apache-2.0 -->
<html><head><meta charset="utf-8"><title>scv-store-bookmarks - scav component</title><link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2016%2016%22%3E%3Ctext%20x%3D%228%22%20y%3D%2212%22%20font-size%3D%2211%22%20font-family%3D%22monospace%22%20fill%3D%22%23986c98%22%20text-anchor%3D%22middle%22%3E%26lt%3B%26gt%3B%3C%2Ftext%3E%3C%2Fsvg%3E"></head>
<body style="margin:0;background:#1a1c1c">
<scv-store-bookmarks data-scv-component></scv-store-bookmarks>
<script data-scv-comp data-scv-tag="scv-store-bookmarks" data-scv-source="" data-scv-icon="">
customElements.define('scv-store-bookmarks', class extends HTMLElement { constructor() { super();
const _baked = !this.shadowRoot && this.querySelector('template[shadowrootmode], template.custom-shadow');
if (_baked) { this.attachShadow({mode: 'open'}).innerHTML = _baked.innerHTML; _baked.remove(); }
else if (!this.shadowRoot) this.attachShadow({mode: 'open'}).innerHTML = `<style>:host { display: block; }
.bmk { width: 320px; background: var(--background-raised, #252727); border: 1px solid var(--border, #3A3C3C); border-radius: var(--corner-high, 8px); padding: 10px; box-sizing: border-box; font-family: var(--font-mono, 'SF Mono', ui-monospace, monospace); }
.bmk-title { display: block; text-align: center; color: var(--text-faint, #666666); font-size: 13px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px; outline: none; }
.bmk-title:focus { color: var(--input, #8AB6BB); }
.bmk-list { display: flex; flex-direction: column; gap: 6px; }
.lc { display: flex; gap: 10px; padding: 7px; background: var(--background-sunk, #1A1C1C); border-radius: var(--corner-low, 5px); color: var(--text-base, #AAABAC); cursor: pointer; touch-action: none; }
.lc.dragging { opacity: 0.4; }
.lc-thumb { width: 42px; height: 42px; flex: none; object-fit: cover; border-radius: var(--corner-low, 5px); background: var(--background-raised, #252727); pointer-events: none; }
.lc-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; justify-content: center; pointer-events: none; }
.lc-title { font-weight: bold; font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: color 0.12s; }
.lc:hover .lc-title { color: var(--input, #8AB6BB); }
.lc-desc { font-size: 10px; color: var(--text-dim, #888888); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.bmk-add { margin-top: 6px; height: 20px; display: flex; align-items: center; justify-content: center; background: var(--background-sunk, #1A1C1C); border-radius: var(--corner-low, 5px); color: var(--input, #8AB6BB); font-size: 13px; line-height: 1; cursor: pointer; }
.bmk-add:hover { color: var(--text-base, #AAABAC); }
.bmk-add.on, .bmk-input { display: none; }
.bmk-input.on { display: block; margin-top: 6px; }
.bmk-input input { width: 100%; box-sizing: border-box; background: var(--background-sunk, #1A1C1C); border: 1px solid var(--input, #8AB6BB); color: var(--input, #8AB6BB); font-family: inherit; font-size: 12px; padding: 5px 8px; border-radius: var(--corner-low, 5px); outline: none; }</style><div class="bmk">
  <div class="bmk-title" data-scv-slot="label" contenteditable="true">bookmarks</div>
  <div class="bmk-list"></div>
  <div class="bmk-add">+</div>
  <div class="bmk-input"><input type="text" placeholder="paste a url + enter"></div>
</div>`;
const root = this.shadowRoot, host = this, emit = v => this.dispatchEvent(new CustomEvent('scv-emit', { detail: v, bubbles: true, composed: true }));
const listEl = root.querySelector('.bmk-list');
const addEl = root.querySelector('.bmk-add');
const inputRow = root.querySelector('.bmk-input');
const inputEl = inputRow.querySelector('input');

const meta = url => { try { const u = new URL(url); return { title: u.hostname.replace(/^www\./, ''), desc: (u.pathname + u.search).slice(1) || 'root', img: u.origin + '/favicon.ico', href: u.href }; } catch { return null; } };

const enrich = a => { // quests unfurl fills real title/desc/image; marks done so reopen doesn't refetch
  const api = window.__QUEST_API__; if (!api || a.dataset.lc) return;
  fetch(api + '/unfurl?url=' + encodeURIComponent(a.dataset.url)).then(r => r.ok ? r.json() : null).then(d => {
    if (!d) return;
    if (d.title) a.querySelector('.lc-title').textContent = d.title;
    if (d.description) a.querySelector('.lc-desc').textContent = d.description;
    if (d.image) a.querySelector('.lc-thumb').src = d.image;
    a.dataset.lc = '1';
  }).catch(() => {});
};

const addCard = (url, silent) => { // build a link card via dom; non-url fails silently; emit unless the value arrived on a wire (auto-forward covers that)
  const m = meta(url); if (!m) return false;
  const a = document.createElement('div'); a.className = 'lc'; a.dataset.url = m.href; a.title = m.href;
  const img = document.createElement('img'); img.className = 'lc-thumb'; img.src = m.img; img.loading = 'lazy'; img.referrerPolicy = 'no-referrer';
  const body = document.createElement('div'); body.className = 'lc-body';
  const t = document.createElement('div'); t.className = 'lc-title'; t.textContent = m.title;
  const d = document.createElement('div'); d.className = 'lc-desc'; d.textContent = m.desc;
  body.append(t, d); a.append(img, body); listEl.appendChild(a);
  enrich(a); if (!silent) emit(m.href); return true;
};

// pointer-drag reorder: greys the card in place and moves it in the list, no drag-image ghost. no move = a click = open
let drag = null;
root.addEventListener('pointerdown', e => { const c = e.target.closest('.lc'); if (!c) return; drag = { el: c, y0: e.clientY, moved: false, id: e.pointerId }; });
root.addEventListener('pointermove', e => {
  if (!drag) return;
  if (!drag.moved) { if (Math.abs(e.clientY - drag.y0) < 4) return; drag.moved = true; drag.el.classList.add('dragging'); try { drag.el.setPointerCapture(drag.id); } catch {} }
  const after = [...listEl.querySelectorAll('.lc:not(.dragging)')].find(c => e.clientY < c.getBoundingClientRect().top + c.offsetHeight / 2);
  if (after) listEl.insertBefore(drag.el, after); else listEl.appendChild(drag.el);
});
root.addEventListener('pointerup', () => { if (!drag) return; if (drag.moved) drag.el.classList.remove('dragging'); else window.open(drag.el.dataset.url, '_blank', 'noopener'); drag = null; });

root.addEventListener('click', e => { if (e.target.closest('.bmk-add')) { addEl.classList.add('on'); inputRow.classList.add('on'); inputEl.focus(); } });
root.addEventListener('keydown', e => {
  if (!e.target.closest('.bmk-input input')) return;
  if (e.key === 'Enter' && e.target.value.trim()) { addCard(e.target.value.trim()); e.target.value = ''; inputRow.classList.remove('on'); addEl.classList.remove('on'); }
});
root.addEventListener('blur', e => { if (e.target.closest('.bmk-input input')) { inputRow.classList.remove('on'); addEl.classList.remove('on'); } }, true);
host.addEventListener('scv-receive', e => { addCard(String(e.detail), true); }); // wire url -> add, silent (runtime auto-forward emits it)
}
connectedCallback() { this.setAttribute('data-scv-emitter', ''); } });
</script>
</body></html>