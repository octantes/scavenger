customElements.define('scv-audio-track', class extends HTMLElement { constructor() { super();
const _baked = !this.shadowRoot && this.querySelector('template[shadowrootmode], template.custom-shadow');
if (_baked) { this.attachShadow({mode: 'open'}).innerHTML = _baked.innerHTML; _baked.remove(); }
else if (!this.shadowRoot) this.attachShadow({mode: 'open'}).innerHTML = `<style>:host { display: block; }
  .at { width: 280px; background: var(--background-raised, #252727); border: 1px solid var(--border, #3A3C3C); border-radius: var(--corner-high, 8px); padding: 8px 10px 10px; box-sizing: border-box; font-family: var(--font-mono, 'SF Mono', ui-monospace, monospace); user-select: none; -webkit-user-select: none; }
  .at-name { color: var(--text-base, #AAABAC); font-size: 11px; text-transform: lowercase; letter-spacing: 1px; text-align: center; outline: none; margin-bottom: 10px; margin-top: 4px; }
  .at-name:focus, .at-name:hover { color: var(--input, #8AB6BB); }
  .at-rows { display: flex; flex-direction: column; gap: 3px; }
  .at-row, .at-add { display: flex; align-items: center; gap: 6px; height: 28px; box-sizing: border-box; padding: 0 4px; background: var(--background-sunk, #1A1C1C); border-radius: var(--corner-low, 5px); }
  .at-add { border: none; }
  .at-row.recv { background: var(--output, #986C98); color: var(--background-sunk, #1A1C1C); border: 1px solid var(--output, #986C98); }
  .at-pp { flex: none; width: 24px; height: 24px; box-sizing: border-box; border: none; border-radius: var(--corner-low, 5px); background: transparent; color: var(--text-base, #AAABAC); cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .at-pp:hover { color: var(--input, #8AB6BB); }
  .at-pp svg, .at-rm svg, .at-add svg { fill: currentColor; pointer-events: none; display: block; }
  .at-pp svg { width: 13px; height: 13px; }
  .at-tname { flex: 1; min-width: 0; font-size: 10px; color: var(--text-base, #AAABAC); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: default; }
  .at-tname.editing { box-sizing: border-box; background: var(--background-sunk, #1A1C1C); color: var(--input, #8AB6BB); border: none; border-radius: var(--corner-low, 3px); padding: 0 5px; outline: none; }
  .at-rm { flex: none; width: 20px; height: 20px; box-sizing: border-box; border: none; border-radius: var(--corner-low, 3px); background: transparent; color: var(--text-base, #AAABAC); cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .at-rm:hover { background: var(--background-sunk, #1A1C1C); color: var(--output, #986C98); }
  .at-rm svg { width: 11px; height: 11px; }
  .at-add { justify-content: center; color: var(--input, #8AB6BB); cursor: pointer; width: 100%; }
  .at-add:hover { color: var(--output, #986C98); }
  .at-add svg { width: 15px; height: 15px; }
  .at-add.rec { color: var(--text-base, #AAABAC); }
  .at-add.rec:hover { color: var(--output, #986C98); }
  .at-meter { position: relative; height: 120px; margin: 8px 0 2px; background: var(--background-sunk, #1A1C1C); border-radius: var(--corner-low, 5px); overflow: hidden; touch-action: none; }
  .at-bars { position: absolute; inset: 0; display: flex; gap: 2px; align-items: flex-end; justify-content: center; padding: 2px; box-sizing: border-box; pointer-events: none; }
  .at-bar { width: 10px; height: 0%; background: var(--input, #8AB6BB); border-radius: 2px; }
  .at-bar:nth-child(2) { background: var(--output, #986C98); }
  .at-caret { position: absolute; left: 4px; right: 4px; height: 2px; background: var(--text-base, #AAABAC); box-shadow: 0 0 4px rgba(0,0,0,0.6); cursor: ns-resize; }
  .at-caret .at-caret-dot { position: absolute; top: -3px; left: 50%; width: 10px; height: 10px; margin-left: -5px; border-radius: 50%; background: var(--text-base, #AAABAC); box-shadow: 0 0 5px rgba(0,0,0,0.6); }
  .at-pan { position: relative; width: 58px; height: 35px; margin: 10px auto 12px; cursor: ns-resize; touch-action: none; }
  .at-pan svg { width: 100%; height: 100%; display: block; }
  .pan-base { fill: none; stroke: var(--background-sunk, #1A1C1C); stroke-width: 5; stroke-linecap: round; }
  .pan-val { fill: none; stroke: var(--input, #8AB6BB); stroke-width: 5; stroke-linecap: round; }
  .pan-ptr { stroke: var(--text-base, #AAABAC); stroke-width: 3; stroke-linecap: round; }
  .at-arm { display: block; width: 100%; height: 24px; margin-top: 4px; box-sizing: border-box; border: none; border-radius: var(--corner-low, 5px); background: var(--background-sunk, #1A1C1C); color: var(--text-dim, #888888); font: 9px var(--font-mono, 'SF Mono', monospace); text-transform: uppercase; letter-spacing: 1px; cursor: pointer; }
  .at-arm:hover { color: var(--text-base, #AAABAC); }
  .at-arm.on { background: var(--output, #986C98); color: var(--background-sunk, #1A1C1C); }
  .at-vis { display: block; width: 100%; box-sizing: border-box; margin-top: 8px; border: 1px solid var(--border, #3A3C3C); border-radius: var(--corner-low, 5px); padding: 6px 8px; font-size: 10px; letter-spacing: 1px; opacity: .85; }
  .at-port { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .at-ins, .at-outs { display: flex; flex-direction: column; gap: 4px; }
  .at-p { display: flex; align-items: center; gap: 6px; font-size: 9px; letter-spacing: 1px; text-transform: lowercase; position: relative; }
  .at-p::before { content: ''; width: 6px; height: 6px; border-radius: 50%; flex: none; }
  .at-in { color: var(--input, #8AB6BB); }
  .at-in::before { background: var(--input, #8AB6BB); }
  .at-out { color: var(--output, #986C98); }
  .at-out::before { background: var(--output, #986C98); }
  .ghost-port { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; border: none; padding: 0; margin: 0; background: transparent; font: inherit; color: inherit; outline: none; cursor: crosshair; }
  .at-file-in { display: none; }
  textarea[hidden] { display: none; }</style><div class="at">
  <div class="at-name" data-scv-slot="label" contenteditable="true">audio track</div>
  <div class="at-rows">
    <button type="button" class="at-add" data-at="add" title="add take">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4h4v6h6v4h-6v6h-4v-6H4v-4h6z"></path></svg>
    </button>
  </div>
  <div class="at-meter">
    <div class="at-bars"><div class="at-bar" data-at="barL"></div><div class="at-bar" data-at="barR"></div></div>
