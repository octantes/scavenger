<!DOCTYPE html>  <!-- scavenge.ar - © 2026 octantes.ar - SPDX-License-Identifier: Apache-2.0 -->
<html><head><meta charset="utf-8"><title>scv-store-audio - scav component</title><link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2016%2016%22%3E%3Ctext%20x%3D%228%22%20y%3D%2212%22%20font-size%3D%2211%22%20font-family%3D%22monospace%22%20fill%3D%22%23986c98%22%20text-anchor%3D%22middle%22%3E%26lt%3B%26gt%3B%3C%2Ftext%3E%3C%2Fsvg%3E"></head>
<body style="margin:0;background:#1a1c1c">
<scv-store-audio data-scv-component></scv-store-audio>
<script data-scv-comp data-scv-tag="scv-store-audio" data-scv-source="" data-scv-icon="">
customElements.define('scv-store-audio', class extends HTMLElement { constructor() { super();
const _baked = !this.shadowRoot && this.querySelector('template[shadowrootmode], template.custom-shadow');
if (_baked) { this.attachShadow({mode: 'open'}).innerHTML = _baked.innerHTML; _baked.remove(); }
else if (!this.shadowRoot) this.attachShadow({mode: 'open'}).innerHTML = `<style>:host { display: block; }
  .au { width: 300px; background: var(--background-raised, #252727); border: 1px solid var(--border, #3A3C3C); border-radius: var(--corner-high, 8px); padding: 8px 10px 10px; box-sizing: border-box; font-family: var(--font-mono, 'SF Mono', ui-monospace, monospace); }
  .au-lab { color: var(--text-faint, #666666); font-size: 10px; text-transform: lowercase; letter-spacing: 1px; margin-bottom: 6px; }
  .au-panel { display: flex; flex-direction: column; gap: 4px; background: var(--background-sunk, #1A1C1C); border-radius: var(--corner-low, 5px); padding: 6px; box-sizing: border-box; margin-bottom: 4px; }
  .au-name { font-size: 10px; color: var(--text-base, #AAABAC); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .au-idx { font-size: 9px; color: var(--text-faint, #666666); text-align: center; }
  .au-bar { position: relative; flex: none; height: 10px; background: var(--background-raised, #252727); border-radius: var(--corner-low, 5px); overflow: hidden; cursor: pointer; }
  .au-fill { height: 100%; width: 0%; background: var(--input, #8AB6BB); border-radius: inherit; pointer-events: none; }
  .au-time { display: flex; justify-content: space-between; font-size: 9px; color: var(--text-dim, #888888); }
  .au-ctrl { display: flex; align-items: stretch; gap: 4px; }
  .au-btn { flex: 1; min-width: 0; height: 28px; box-sizing: border-box; background: var(--background-sunk, #1A1C1C); border: none; border-radius: var(--corner-low, 5px); color: var(--text-base, #AAABAC); cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .au-btn:hover { color: var(--output, #986C98); }
  .au-btn:active { transform: translateY(1px); background: var(--background-raised, #252727); }
  .au-btn svg { width: 14px; height: 14px; fill: currentColor; pointer-events: none; display: block; }
  .au-engine { display: none; }
  .au-file-in { display: none; }
  textarea[hidden] { display: none; }</style><div class="au">
  <div class="au-lab" data-scv-slot="label">audio</div>
  <div class="au-panel">
    <div class="au-name" data-au="name">—</div>
    <div class="au-bar" data-au="bar"><div class="au-fill" data-au="fill"></div></div>
    <div class="au-time">
      <span data-au="cur">0:00</span>
      <span class="au-idx" data-au="idx"></span>
      <span data-au="dur">0:00</span>
    </div>
    <audio class="au-engine" data-au="engine"></audio>
  </div>
  <div class="au-ctrl">
    <button type="button" class="au-btn" data-au="back" title="previous track">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6h2v12H6zm10.5 0L9 12l7.5 6z"></path></svg>
    </button>
    <button type="button" class="au-btn" data-au="add" title="add audio">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4h4v6h6v4h-6v6h-4v-6H4v-4h6z"></path></svg>
    </button>
    <button type="button" class="au-btn" data-au="play" title="play/pause">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path data-au="playicon" d="M8 5v14l11-7z"></path></svg>
    </button>
    <button type="button" class="au-btn" data-au="stop" title="stop">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="6" width="12" height="12"></rect></svg>
    </button>
    <button type="button" class="au-btn" data-au="fwd" title="next track">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 6h-2v12h2zM7.5 6 15 12l-7.5 6z"></path></svg>
    </button>
  </div>
  <input type="file" accept="audio/*" class="au-file-in" data-au="file">
  <textarea data-scv-slot="audio" hidden=""></textarea>
</div>`;
const root = this.shadowRoot, host = this, emit = v => this.dispatchEvent(new CustomEvent('scv-emit', { detail: v, bubbles: true, composed: true }));
const eng = root.querySelector('[data-au="engine"]'), back = root.querySelector('[data-au="back"]'),
        fwd = root.querySelector('[data-au="fwd"]'), play = root.querySelector('[data-au="play"]'),
        stop = root.querySelector('[data-au="stop"]'), add = root.querySelector('[data-au="add"]'),
        playIcon = root.querySelector('[data-au="playicon"]'),
        bar = root.querySelector('[data-au="bar"]'), fill = root.querySelector('[data-au="fill"]'),
        curEl = root.querySelector('[data-au="cur"]'), durEl = root.querySelector('[data-au="dur"]'),
        nameEl = root.querySelector('[data-au="name"]'), idxEl = root.querySelector('[data-au="idx"]'),
        fileIn = root.querySelector('[data-au="file"]'), slot = root.querySelector('[data-scv-slot="audio"]');
  let tracks = [];
  let idx = -1, playing = false;
  const NAME_OF = u => { const m = /^data:([^;,]+)/.exec(u); const ext = m && m[1].includes('mpeg') ? 'mp3' : m && m[1].includes('ogg') ? 'ogg' : m && m[1].includes('wav') ? 'wav' : 'audio'; return 'track ' + (idx + 1) + '.' + ext; };
  const toDataURL = file => new Promise((res, rej) => { const r = new FileReader(); r.onload = () => res({ url: r.result, name: file.name }); r.onerror = rej; r.readAsDataURL(file); }); // native path, same as patchbay
  const ft = s => { if (!isFinite(s)) return '0:00'; const m = Math.floor(s / 60), ss = Math.floor(s % 60); return m + ':' + String(ss).padStart(2, '0'); };
  const setPlayBtn = () => { playIcon.setAttribute('d', playing ? 'M7 5v14l11-7zM7 5' : 'M8 5v14l11-7z'); play.title = playing ? 'pause' : 'play'; };
  function persist() { slot.value = tracks.map(t => t.name ? t.name + '\n' + t.url : t.url).join('\n'); }
  function show() {
    if (tracks.length === 0) { eng.removeAttribute('src'); nameEl.textContent = '—'; idxEl.textContent = ''; curEl.textContent = '0:00'; durEl.textContent = '0:00'; fill.style.width = '0%'; return; }
    if (idx >= tracks.length) idx = 0; if (idx < 0) idx = tracks.length - 1;
    eng.setAttribute('src', tracks[idx].url); eng.load();
    nameEl.textContent = tracks[idx].name || NAME_OF(tracks[idx].url);
    idxEl.textContent = (idx + 1) + ' / ' + tracks.length;
  }
  const emitCurrent = () => { if (tracks.length && eng.getAttribute('src')) eng.dispatchEvent(new CustomEvent('scv-emit', { detail: eng.getAttribute('src'), bubbles: true, composed: true })); };
  const setTrack = i => { idx = (i + tracks.length) % tracks.length; show(); if (playing) eng.play().catch(() => {}); };
  function toggle() { if (!tracks.length) return; if (eng.paused) eng.play().catch(() => {}); else eng.pause(); }
  function doStop() { eng.pause(); try { eng.currentTime = 0; } catch (e) {} playing = false; setPlayBtn(); curEl.textContent = '0:00'; fill.style.width = '0%'; }
  back.addEventListener('click', () => { if (tracks.length) { playing = false; setPlayBtn(); setTrack(idx - 1); } });
  fwd.addEventListener('click', () => { if (tracks.length) { playing = false; setPlayBtn(); setTrack(idx + 1); } });
  play.addEventListener('click', () => { if (tracks.length) toggle(); });
  stop.addEventListener('click', doStop);
  add.addEventListener('click', () => fileIn.click());
  eng.addEventListener('play', () => { playing = true; setPlayBtn(); emitCurrent(); });
  eng.addEventListener('pause', () => { playing = false; setPlayBtn(); });
  eng.addEventListener('timeupdate', () => { curEl.textContent = ft(eng.currentTime); fill.style.width = (eng.duration ? (eng.currentTime / eng.duration) * 100 : 0) + '%'; });
  eng.addEventListener('loadedmetadata', () => { durEl.textContent = ft(eng.duration); });
  eng.addEventListener('ended', () => { if (tracks.length > 1) { playing = false; setPlayBtn(); setTrack(idx + 1); } else { playing = false; setPlayBtn(); } });
  bar.addEventListener('click', e => { if (eng.duration) { const r = bar.getBoundingClientRect(); eng.currentTime = ((e.clientX - r.left) / r.width) * eng.duration; } });
  fileIn.addEventListener('change', () => {
    const f = fileIn.files[0];
    if (f && f.type.startsWith('audio/')) toDataURL(f).then(t => { tracks.push(t); idx = tracks.length - 1; show(); persist(); eng.play().catch(() => {}); });
    fileIn.value = '';
  });
  function render() {
    const parts = slot.value.split('\n').map(s => s.trim()).filter(Boolean);
    tracks = [];
    let pending = '';
    for (const p of parts) {
      if (p.startsWith('data:')) { tracks.push({ url: p, name: pending }); pending = ''; }
      else pending = p;
    }
    if (tracks.length) idx = Math.min(idx < 0 ? 0 : idx, tracks.length - 1);
    show();
  }
    function boot() { render(); setPlayBtn(); }
  boot();
  requestAnimationFrame(boot);
  setTimeout(boot, 0);
}
connectedCallback() { this.setAttribute('data-scv-emitter', ''); } });
</script>
</body></html>