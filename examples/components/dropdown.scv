<!DOCTYPE html>  <!-- scavenge.ar - © 2026 octantes.ar - SPDX-License-Identifier: Apache-2.0 -->
<html><head><meta charset="utf-8"><title>scv-dropdown - scav component</title><link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2016%2016%22%3E%3Ctext%20x%3D%228%22%20y%3D%2212%22%20font-size%3D%2211%22%20font-family%3D%22monospace%22%20fill%3D%22%23986c98%22%20text-anchor%3D%22middle%22%3E%26lt%3B%26gt%3B%3C%2Ftext%3E%3C%2Fsvg%3E"></head>
<body style="margin:0;background:#1a1c1c">
<scv-dropdown data-scv-component></scv-dropdown>
<script data-scv-comp data-scv-tag="scv-dropdown" data-scv-source="" data-scv-icon="">
customElements.define('scv-dropdown', class extends HTMLElement { constructor() { super();
const _baked = !this.shadowRoot && this.querySelector('template[shadowrootmode], template.custom-shadow');
if (_baked) { this.attachShadow({mode: 'open'}).innerHTML = _baked.innerHTML; _baked.remove(); }
else if (!this.shadowRoot) this.attachShadow({mode: 'open'}).innerHTML = `<style>:host { display: block; }
  .sl { width: 240px; background: var(--background-raised, #252727); border: 1px solid var(--border, #3A3C3C); border-radius: var(--corner-low, 5px); padding: 8px 10px; box-sizing: border-box; font-family: var(--font-mono, 'SF Mono', ui-monospace, monospace); }
  .sl-lab { color: var(--text-faint, #666666); font-size: 10px; text-transform: lowercase; letter-spacing: 1px; margin-bottom: 6px; }
  .sl-row { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 6px; }
  .sl-in, .sl-out { display: flex; align-items: center; gap: 6px; font-size: 9px; letter-spacing: 1px; text-transform: lowercase; opacity: .85; }
  .sl-in { color: var(--input, #8AB6BB); }
  .sl-out { color: var(--output, #986C98); }
  .sl-in::before, .sl-out::before { content: ''; width: 6px; height: 6px; border-radius: 50%; }
  .sl-in::before { background: var(--input, #8AB6BB); }
  .sl-out::before { background: var(--output, #986C98); }
  .sl-in-val { color: var(--text-base, #AAABAC); }
  .sl-options { width: 100%; box-sizing: border-box; background: var(--background-sunk, #1A1C1C); border: 1px solid var(--border, #3A3C3C); border-radius: var(--corner-low, 5px); color: var(--text-dim, #888888); font: 10px var(--font-mono, 'SF Mono', monospace); padding: 4px 6px; margin-bottom: 6px; outline: none; }
  .sl-options:focus { color: var(--text-base, #AAABAC); border-color: var(--input, #8AB6BB); }
  select { width: 100%; box-sizing: border-box; background: var(--background-sunk, #1A1C1C); border: 1px solid var(--border, #3A3C3C); border-radius: var(--corner-low, 5px); color: var(--text-base, #AAABAC); font: 12px var(--font-mono, 'SF Mono', monospace); padding: 5px 6px; outline: none; cursor: pointer; }
  select:focus { border-color: var(--input, #8AB6BB); }
  option { background: var(--background-sunk, #1A1C1C); color: var(--text-base, #AAABAC); }</style><div class="sl">
  <div class="sl-lab" data-scv-slot="label">select</div>
  <div class="sl-row">
    <div class="sl-in">in: <span class="sl-in-val" data-scv-receives="">—</span></div>
    <div class="sl-out" data-scv-emits="">out</div>
  </div>
  <input type="text" class="sl-options" data-scv-slot="options" placeholder="a, b, c" spellcheck="false">
  <select data-scv-slot="value" data-scv-receives=""></select>
</div>`;
const root = this.shadowRoot, host = this, emit = v => this.dispatchEvent(new CustomEvent('scv-emit', { detail: v, bubbles: true, composed: true }));
const opts = root.querySelector('.sl-options'), sel = root.querySelector('select'),
        inVal = root.querySelector('.sl-in-val'), outPort = root.querySelector('.sl-out');
  let _last = '';
  const fmt = v => v === undefined ? 'undefined' : (typeof v === 'object' ? JSON.stringify(v) : v);
  const LIST = ['a', 'b', 'c'];
  function parseList() {
    const raw = (opts.value || '').split(',').map(s => s.trim()).filter(Boolean);
    return raw.length ? raw : LIST.slice();
  }
  function render() {
    const cur = sel.value;
    const items = parseList();
    sel.innerHTML = items.map(o => `<option value="${o.replace(/"/g, '&quot;')}">${o}</option>`).join('');
    if (items.includes(cur)) sel.value = cur;
    else if (items.length) sel.value = items[0];
    _last = sel.value;
  }
  opts.addEventListener('input', render);
  sel.addEventListener('change', () => emit(_last = sel.value));
  outPort.addEventListener('click', () => { if (_last !== undefined && _last !== '') emit(_last); });
  host.addEventListener('scv-receive', e => {
    const v = e.detail; inVal.textContent = fmt(v);
    const s = String(v);
    for (let k = 0; k < sel.options.length; k++) { if (sel.options[k].value === s) { sel.selectedIndex = k; _last = sel.value; break; } }
    emit(s);
  });
  function boot() { render(); }
  boot();
  requestAnimationFrame(boot);
  setTimeout(boot, 0);
}
connectedCallback() { this.setAttribute('data-scv-emitter', ''); } });
</script>
</body></html>